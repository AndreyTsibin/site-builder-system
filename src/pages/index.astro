---
import BaseLayout from '../layouts/BaseLayout.astro';

// Stats Sections
import Stats1 from '../components/sections/stats/Stats1.astro';
import Stats2 from '../components/sections/stats/Stats2.astro';
import Stats3 from '../components/sections/stats/Stats3.astro';

// Emergency Banners
import EmergencyBanner1 from '../components/sections/emergency-banner/EmergencyBanner1.astro';
import EmergencyBanner2 from '../components/sections/emergency-banner/EmergencyBanner2.astro';
import EmergencyBanner3 from '../components/sections/emergency-banner/EmergencyBanner3.astro';

// Before/After Sections
import BeforeAfter1 from '../components/sections/before-after/BeforeAfter1.astro';
import BeforeAfter2 from '../components/sections/before-after/BeforeAfter2.astro';
import BeforeAfter3 from '../components/sections/before-after/BeforeAfter3.astro';

// Portfolio Sections
import Portfolio1 from '../components/sections/portfolio/Portfolio1.astro';
---

<BaseLayout title="Site Builder 2.0 - New Sections Demo">

  <!-- ========================================
       EMERGENCY BANNERS (3 variants)
       ======================================== -->

  <!-- EmergencyBanner1: Sticky Top Bar - TESTED ✅ HIDDEN FOR NOW -->
  <!--
  <EmergencyBanner1
    message="Срочный ремонт 24/7! Выезд мастера за 30 минут"
    icon="ri-alarm-warning-line"
    phone="+7 (999) 123-45-67"
    ctaText="Вызвать сейчас"
    ctaLink="tel:+79991234567"
    bgColor="red-600"
    dismissible={true}
    storageKey="emergency-banner-test-v1"
  />
  -->

  <!-- EmergencyBanner2: Floating Corner Badge - TESTING NOW ⏳ -->
  <EmergencyBanner2
    icon="ri-customer-service-2-fill"
    shortText="24/7"
    expandedMessage="Срочный ремонт в любое время! Выезд мастера за 30 минут."
    phone="+7 (999) 123-45-67"
    ctaText="Вызвать мастера"
    bgColor="red-600"
    pulseAnimation={true}
  />

  <!-- ========================================
       STATS SECTIONS (3 variants)
       ======================================== -->

  <!-- Stats1: Counter Grid (4 metrics with icons) -->
  <Stats1
    title="Компания в цифрах"
    subtitle="Мы гордимся нашими достижениями и доверием клиентов"
    stats={[
      {
        icon: "ri-tools-line",
        value: "500+",
        label: "Выполненных ремонтов",
        description: "За последний год"
      },
      {
        icon: "ri-team-line",
        value: "12",
        suffix: "мастеров",
        label: "Профессиональная команда"
      },
      {
        icon: "ri-calendar-line",
        value: "15",
        suffix: "лет",
        label: "Опыт работы",
        description: "На рынке с 2010 года"
      },
      {
        icon: "ri-star-line",
        value: "98",
        suffix: "%",
        label: "Довольных клиентов"
      }
    ]}
  />

  <!-- Stats2: Horizontal Bar (compact, no icons) -->
  <Stats2
    bgColor="blue-700"
    textColor="white"
    stats={[
      { value: "2000+", label: "Отремонтированных устройств" },
      { value: "24/7", label: "Круглосуточная поддержка" },
      { value: "15", label: "Лет на рынке" },
      { value: "12", label: "Опытных мастеров" }
    ]}
  />

  <!-- Stats3: Featured Stat + Supporting Metrics -->
  <Stats3
    title="Наше главное достижение"
    featuredStat={{
      value: "15",
      suffix: "лет на рынке",
      label: "Лет успешной работы",
      description: "С 2010 года мы помогаем тысячам клиентов решать проблемы с техникой",
      icon: "ri-award-line"
    }}
    supportingStats={[
      { value: "2000+", label: "Довольных клиентов" },
      { value: "500+", label: "Ремонтов в год" },
      { value: "98%", label: "Положительных отзывов" }
    ]}
  />

  <!-- ========================================
       BEFORE/AFTER SECTIONS (3 variants)
       ======================================== -->

  <!-- BeforeAfter1: Single Comparison Slider -->
  <BeforeAfter1
    title="Результаты наших работ"
    subtitle="Мы гарантируем качество каждого ремонта"
    imageBefore="/images/placeholder-img.jpg"
    imageAfter="/images/placeholder-img.jpg"
    serviceLabel="Ремонт холодильника Bosch"
    description="Восстановление компрессора, замена уплотнителя, 1 день работы"
    ctaText="Заказать ремонт"
  />

  <!-- BeforeAfter2: Grid of Comparisons -->
  <BeforeAfter2
    title="Наши работы"
    subtitle="Примеры выполненных ремонтов с гарантией качества"
    comparisons={[
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт холодильника Samsung",
        description: "Замена компрессора, 2 дня"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт стиральной машины LG",
        description: "Замена подшипников, 1 день"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт посудомоечной машины Bosch",
        description: "Замена насоса, 3 часа"
      }
    ]}
    ctaText="Заказать ремонт"
  />

  <!-- BeforeAfter3: Featured with Thumbnails Gallery -->
  <BeforeAfter3
    title="Кейс: Ремонт премиум-техники"
    subtitle="Подробный пример работы с отзывом клиента"
    featured={{
      imageBefore: "/images/placeholder-img.jpg",
      imageAfter: "/images/placeholder-img.jpg",
      serviceName: "Ремонт холодильника Liebherr",
      description: "Полная диагностика, замена компрессора и электроники, 2 дня работы"
    }}
    gallery={[
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт посудомойки Miele",
        description: "Замена насоса и фильтров"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт духовки Gorenje",
        description: "Замена термостата"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт винного шкафа",
        description: "Замена компрессора"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт кофемашины Jura",
        description: "Чистка и замена уплотнителей"
      }
    ]}
    testimonial={{
      text: "Спасибо огромное мастеру Сергею! Отремонтировал холодильник Liebherr за 2 дня. Работает как новый, гарантия 1 год. Рекомендую!",
      author: "Елена Петрова, Москва",
      rating: 5
    }}
    ctaText="Заказать такой же ремонт"
  />

  <!-- ========================================
       PORTFOLIO SECTIONS (1 variant ready)
       ======================================== -->

  <!-- Portfolio1: Fullwidth Slider with Captions -->
  <Portfolio1
    title="Наши работы"
    subtitle="Портфолио выполненных проектов"
    items={[
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт кухни в ЖК Новый",
        category: "Кухонная техника",
        description: "Полный ремонт встроенной техники: холодильник, посудомойка, духовка"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Восстановление холодильника Samsung",
        category: "Холодильники",
        description: "Замена компрессора и системы охлаждения"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт стиральной машины LG",
        category: "Стиральные машины",
        description: "Замена подшипников барабана"
      }
    ]}
    autoPlay={true}
    autoPlayDelay={5000}
  />

  <!-- EmergencyBanner2: Floating Corner Badge (always visible) -->
  <EmergencyBanner2
    icon="ri-customer-service-2-fill"
    shortText="24/7"
    expandedMessage="Срочный ремонт в любое время! Выезд мастера за 30 минут."
    phone="+7 (999) 123-45-67"
    ctaText="Вызвать мастера"
    bgColor="red-600"
    pulseAnimation={true}
  />

</BaseLayout>
