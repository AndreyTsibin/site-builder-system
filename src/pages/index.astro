---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Site Builder | Astro + Tailwind 4">
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-600 to-purple-700">
    <div class="container mx-auto px-4 text-center text-white">
      <h1 class="text-6xl font-bold mb-6">
        Site Builder 2.0
      </h1>
      <p class="text-2xl mb-8 text-white/90">
        Собирайте лендинги за минуты с Astro + Tailwind 4
      </p>
      <div class="flex gap-4 justify-center">
        <a
          href="#features"
          class="px-8 py-4 bg-white text-blue-600 rounded-lg font-semibold hover:bg-blue-50 transition-colors inline-flex items-center gap-2"
        >
          <i class="ri-rocket-line text-xl"></i>
          Начать работу
        </a>
        <a
          href="https://github.com"
          target="_blank"
          class="px-8 py-4 border-2 border-white text-white rounded-lg font-semibold hover:bg-white/10 transition-colors inline-flex items-center gap-2"
        >
          <i class="ri-github-fill text-xl"></i>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4">Почему Site Builder?</h2>
        <p class="text-xl text-gray-600">Современный стек для быстрой разработки</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-4">
            <i class="ri-flashlight-line text-2xl text-white"></i>
          </div>
          <h3 class="text-2xl font-bold mb-3">Молниеносно быстро</h3>
          <p class="text-gray-600">
            Astro генерирует чистый HTML без лишнего JavaScript. Сайты грузятся мгновенно.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mb-4">
            <i class="ri-palette-line text-2xl text-white"></i>
          </div>
          <h3 class="text-2xl font-bold mb-3">Tailwind 4</h3>
          <p class="text-gray-600">
            Новейшая версия Tailwind CSS с Vite плагином. Утилитарные классы для всего.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mb-4">
            <i class="ri-building-line text-2xl text-white"></i>
          </div>
          <h3 class="text-2xl font-bold mb-3">Готовые секции</h3>
          <p class="text-gray-600">
            Библиотека компонентов из Flowbite и HyperUI. Собирайте лендинг как LEGO.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-blue-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold mb-4">Готовы начать?</h2>
      <p class="text-xl mb-8 text-white/90">
        Установите зависимости и запустите проект за 2 минуты
      </p>
      <div class="bg-gray-900 text-green-400 p-6 rounded-lg max-w-2xl mx-auto text-left font-mono">
        <div class="text-sm">
          <div>npm run dev</div>
          <div class="text-gray-500"># → http://localhost:4321</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
