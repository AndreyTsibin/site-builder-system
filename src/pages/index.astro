---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/sections/testimonials/Testimonials.astro';
import Testimonials2 from '../components/sections/testimonials/Testimonials2.astro';
import Testimonials3 from '../components/sections/testimonials/Testimonials3.astro';
---

<BaseLayout title="Site Builder 2.0 | Testimonials Demo">

  <!-- Testimonials - Customer Reviews Carousel -->
  <Testimonials
    heading="Отзывы наших клиентов"
    subheading="Более 2000 довольных клиентов доверяют нам свою технику"
    testimonials={[
      {
        name: 'Иван Петров',
        date: '15.10.2024',
        rating: 5,
        text: 'Отличный сервис! Мастер приехал через 30 минут после звонка, быстро диагностировал проблему и починил стиральную машину прямо на дому. Цены адекватные, работа качественная. Рекомендую!'
      },
      {
        name: 'Мария Сидорова',
        date: '12.10.2024',
        rating: 5,
        text: 'Очень довольна работой! Холодильник LG перестал морозить, думала придется покупать новый. Мастер нашёл проблему за 10 минут, заменил деталь, теперь всё работает отлично. Спасибо большое!'
      },
      {
        name: 'Алексей Смирнов',
        date: '08.10.2024',
        rating: 5,
        text: 'Профессиональный подход! Посудомоечная машина сломалась в самый неподходящий момент. Позвонил, мастер приехал в тот же день, всё починил за час. Дали гарантию на 12 месяцев. Очень доволен!'
      },
      {
        name: 'Елена Кузнецова',
        date: '05.10.2024',
        rating: 5,
        text: 'Рекомендую всем! Микроволновка перестала греть, думала что всё — пора на помойку. Мастер приехал, разобрал, заменил магнетрон, всё объяснил. Теперь работает как новая!'
      },
      {
        name: 'Дмитрий Соколов',
        date: '01.10.2024',
        rating: 5,
        text: 'Быстро, качественно, недорого! Стиральная машина выдавала ошибку, мастер приехал в течение часа, нашёл засор в фильтре, всё почистил. Работа заняла 20 минут. Отличный сервис!'
      },
      {
        name: 'Ольга Новикова',
        date: '28.09.2024',
        rating: 5,
        text: 'Очень благодарна мастеру! Духовка перестала включаться, думала что ремонт будет дорогим. Оказалось всего лишь проблема с датчиком, заменили быстро и недорого. Теперь всё работает!'
      }
    ]}
  />

