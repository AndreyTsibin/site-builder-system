---
import BaseLayout from '../layouts/BaseLayout.astro';

// Calculator Sections
import Calculator1 from '../components/sections/calculator/Calculator1.astro';
import Calculator2 from '../components/sections/calculator/Calculator2.astro';
---

<BaseLayout title="Site Builder 2.0 - Calculator Demo">

  <!-- ========================================
       CALCULATOR SECTIONS (2 variants)
       ======================================== -->

  <!-- Calculator1: Simple Cost Estimator -->
  <Calculator1
    title="Рассчитайте стоимость ремонта"
    subtitle="Узнайте примерную стоимость за 1 минуту"
    deviceTypes={[
      { label: "Холодильник", value: "refrigerator", price: 500 },
      { label: "Стиральная машина", value: "washer", price: 600 },
      { label: "Посудомоечная машина", value: "dishwasher", price: 550 },
      { label: "Духовой шкаф", value: "oven", price: 450 },
      { label: "Варочная панель", value: "cooktop", price: 400 },
      { label: "Микроволновая печь", value: "microwave", price: 300 }
    ]}
    problemTypes={[
      { label: "Не включается", value: "no_power", price: 800 },
      { label: "Шумит / вибрирует", value: "noise", price: 600 },
      { label: "Течет вода", value: "leak", price: 700 },
      { label: "Не греет / не морозит", value: "temp", price: 900 },
      { label: "Не работает функция", value: "function", price: 500 }
    ]}
    urgencyOptions={[
      { label: "Обычный (2-3 дня)", value: "normal", price: 0 },
      { label: "Экспресс (сегодня)", value: "express", price: 1000 }
    ]}
    baseFee={500}
    resultLabel="Примерная стоимость:"
    disclaimer="Точная цена после бесплатной диагностики"
    ctaText="Вызвать мастера"
    ctaLink="tel:+79991234567"
  />

  <!-- Calculator2: Detailed Multi-Step Calculator -->
  <Calculator2
    title="Подробный расчет стоимости"
    subtitle="Точная оценка за 3 простых шага"
    steps={[
      {
        title: "Шаг 1: Выберите тип устройства",
        options: [
          { label: "Холодильник", icon: "ri-fridge-line", price: 500, description: "Ремонт холодильного оборудования" },
          { label: "Стиральная машина", icon: "ri-shirt-line", price: 600, description: "Ремонт стиральных машин" },
          { label: "Посудомойка", icon: "ri-cup-line", price: 550, description: "Ремонт посудомоечных машин" },
          { label: "Духовой шкаф", icon: "ri-fire-line", price: 450, description: "Ремонт духовых шкафов" }
        ]
      },
      {
        title: "Шаг 2: Выберите проблемы (можно несколько)",
        allowMultiple: true,
        options: [
          { label: "Не включается", icon: "ri-power-off-line", price: 800 },
          { label: "Шумит", icon: "ri-volume-up-line", price: 600 },
          { label: "Течет", icon: "ri-drop-line", price: 700 },
          { label: "Не греет/морозит", icon: "ri-temp-cold-line", price: 900 },
          { label: "Не работает функция", icon: "ri-settings-4-line", price: 500 }
        ]
      },
      {
        title: "Шаг 3: Дополнительные услуги",
        allowMultiple: true,
        options: [
          { label: "Гарантия 1 год", icon: "ri-shield-check-line", price: 500, description: "Расширенная гарантия" },
          { label: "Экспресс (сегодня)", icon: "ri-rocket-line", price: 1000, description: "Выезд в течение 2 часов" },
          { label: "Оригинальные запчасти", icon: "ri-tools-line", price: 300, description: "Гарантия качества" },
          { label: "Ничего не нужно", icon: "ri-close-line", price: 0, description: "Без дополнительных услуг" }
        ]
      }
    ]}
    baseFee={500}
    resultScreen={{
      title: "Ваша смета готова!",
      priceLabel: "Итоговая стоимость:",
      breakdown: true,
      ctaText: "Заказать ремонт",
      leadForm: {
        nameLabel: "Ваше имя",
        phoneLabel: "Телефон",
        submitText: "Отправить заявку"
      }
    }}
  />

</BaseLayout>
