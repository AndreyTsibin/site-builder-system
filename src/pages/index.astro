---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero1 from '@/components/sections/heroes/Hero1.astro';
import Hero2 from '@/components/sections/heroes/Hero2.astro';
import Hero3 from '@/components/sections/heroes/Hero3.astro';
import Hero4 from '@/components/sections/heroes/Hero4.astro';
---

<BaseLayout title="Site Builder 2.0 | Component Library Demo">
  <!-- Hero Section -->
  <Hero1
    title="Ремонт бытовой техники в Москве"
    subtitle="Выезд мастера за 30 минут. Диагностика бесплатно. Гарантия до 2 лет на все виды работ."
    primaryCtaText="Вызвать мастера"
    primaryCtaUrl="#contact"
    secondaryCtaText="Наши услуги"
    secondaryCtaUrl="#services"
    imageUrl="/images/placeholder-img.jpg"
    imageAlt="Ремонт бытовой техники"
  />

  <!-- Hero Section 2 - With Benefits List -->
  <Hero2
    title="Срочный ремонт стиральных машин в СПБ за 1 час"
    subtitle="Устраняем любые неисправности стиральных машин всех марок. Бесплатная диагностика и выезд мастера"
    benefits={[
      { icon: "ri-time-line", text: "Мастер за 60 минут" },
      { icon: "ri-tools-line", text: "Запчасти в наличии" },
      { icon: "ri-shield-check-line", text: "Гарантия до 12 месяцев" }
    ]}
    ctaText="Вызвать мастера бесплатно"
    ctaUrl="#contact"
    imageUrl="/images/placeholder-img.jpg"
    imageAlt="Мастер по ремонту стиральных машин"
  />

  <!-- Hero Section 3 - With Contact Form -->
  <Hero3
    title="Ремонт техники LG"
    titleHighlight="LG"
    subtitle="в СПБ и области"
    description="<strong class='underline decoration-dotted cursor-help' title='Бесплатно при заказе ремонта'>Бесплатный</strong> выезд специалиста для диагностики и профессионального ремонта техники LG"
    benefits={[
      { icon: "ri-checkbox-circle-line", text: "Запчасти от производителя" },
      { icon: "ri-checkbox-circle-line", text: "Выезд в течение часа" },
      { icon: "ri-checkbox-circle-line", text: "Гарантия на услуги до 2 лет" }
    ]}
    phonePlaceholder="+7 (000) 000-00-00"
    submitText="Вызвать мастера"
    privacyText="Отправляя форму, вы соглашаетесь с <a href='/privacy' class='text-blue-600 hover:underline'>Политикой конфиденциальности</a>"
    imageUrl="/images/placeholder-img.jpg"
    imageAlt="Мастер по ремонту техники LG"
  />

  <!-- Hero Section 4 - With Form Card & Trust Badges -->
  <Hero4
    title="Надежные видеодомофоны с установкой под ключ"
    subtitle="Безопасность вашего дома под умной защитой"
    formTitle="Получите бесплатную консультацию"
    phonePlaceholder="+7 (000) 000-00-00"
    submitText="Получить консультацию"
    formNote="Напишите номер. Перезвоним через 1 минуту!"
    trustBadges={[
      { icon: "ri-home-office-line", text: "10 лет устанавливаем видеодомофоны" },
      { icon: "ri-user-star-line", text: "Более 1500 довольных клиентов" },
      { icon: "ri-shield-check-line", text: "Гарантия 3 года на оборудование" }
    ]}
    imageUrl="/images/placeholder-img.jpg"
    imageAlt="Установка видеодомофонов"
  />

  <!-- More sections will be added here as they are completed -->
</BaseLayout>
