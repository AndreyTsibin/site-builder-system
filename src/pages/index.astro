---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header1Material from '../components/sections/material/header/Header1Material.astro';
import Hero3Material from '../components/sections/material/heroes/Hero3Material.astro';
import ServicesCardsMaterial from '../components/sections/material/pricing/ServicesCardsMaterial.astro';
import Benefits2Material from '../components/sections/material/benefits/Benefits2Material.astro';
import HowItWorks2Material from '../components/sections/material/how-it-works/HowItWorks2Material.astro';
import Testimonials2Material from '../components/sections/material/testimonials/Testimonials2Material.astro';
import FAQ2Material from '../components/sections/material/faq/FAQ2Material.astro';
import Footer2Material from '../components/sections/material/footer/Footer2Material.astro';
---

<BaseLayout title="Ремонт стиральных машин на дому в СПБ | ТехСпец">

  <Header1Material
    logo="ТехСпец"
    phone="+7 (812) 213-07-14"
    menuItems={[
      { label: 'Услуги', href: '#services' },
      { label: 'Преимущества', href: '#benefits' },
      { label: 'Отзывы', href: '#testimonials' },
      { label: 'Контакты', href: '#faq' }
    ]}
    ctaText="Вызвать мастера"
    ctaLink="#lid-form"
  />

  <Hero3Material
    title="Ремонт стиральных машин на дому в СПБ"
    subtitle="Скидка 25% на первый ремонт"
    description="Не крутит, шумит, течёт — разберёмся быстро и аккуратно. Фикс‑прайс до начала работ. Бесплатная диагностика."
    benefits={[
      { icon: "ri-time-line", text: "Приезжаем за 30 минут" },
      { icon: "ri-tools-line", text: "Ремонт за 1 час" },
      { icon: "ri-shield-check-line", text: "Гарантия 2 года" },
      { icon: "ri-price-tag-3-line", text: "Скидка 25% на первый ремонт" }
    ]}
    ctaText="Вызвать мастера"
    ctaHref="#lid-form"
    imageUrl="https://static.tildacdn.com/tild6133-6463-4461-a165-383363323936/photo.jpg"
    imageAlt="Ремонт стиральных машин на дому"
  />

  <ServicesCardsMaterial
    id="services"
    heading="Стоимость ремонта"
    subheading="Фиксированные цены. Оплата после выполнения работ"
    services={[
      {
        name: "Не вращается барабан",
        price: "540₽",
        description: "Диагностика и устранение проблемы с вращением барабана",
        icon: "ri-settings-3-line"
      },
      {
        name: "Не отжимает",
        price: "340₽",
        description: "Восстановление функции отжима",
        icon: "ri-loader-4-line"
      },
      {
        name: "Не заливает воду",
        price: "380₽",
        description: "Ремонт системы подачи воды",
        icon: "ri-drop-line"
      },
      {
        name: "Не сливает воду",
        price: "320₽",
        description: "Устранение засоров и ремонт помпы",
        icon: "ri-water-flash-line"
      },
      {
        name: "Сильно шумит",
        price: "550₽",
        description: "Замена амортизаторов и подшипников",
        icon: "ri-volume-up-line"
      },
      {
        name: "Не включается",
        price: "400₽",
        description: "Диагностика и ремонт электрики",
        icon: "ri-plug-line"
      }
    ]}
    ctaText="Заказать ремонт"
    ctaUrl="#lid-form"
  />

  <Benefits2Material
    id="benefits"
    heading="Почему выбирают ТехСпец"
    subheading="15 лет на рынке ремонта бытовой техники"
    benefits={[
      {
        title: "Быстрый выезд",
        description: "Приезжаем в течение 30 минут",
        icon: "ri-time-line"
      },
      {
        title: "Опытные мастера",
        description: "Стаж работы от 10 лет",
        icon: "ri-user-star-line"
      },
      {
        title: "Гарантия 2 года",
        description: "На все виды работ и запчасти",
        icon: "ri-shield-check-line"
      },
      {
        title: "Оригинальные запчасти",
        description: "Работаем напрямую с поставщиками",
        icon: "ri-box-3-line"
      },
      {
        title: "Работаем 24/7",
        description: "Без выходных и праздников",
        icon: "ri-24-hours-line"
      },
      {
        title: "Честные цены",
        description: "Без скрытых доплат",
        icon: "ri-price-tag-3-line"
      }
    ]}
    colorTheme="blue"
  />

  <HowItWorks2Material
    id="how-it-works"
    heading="Как мы работаем"
    subheading="Простой процесс от звонка до гарантии"
    steps={[
      {
        number: 1,
        title: "Звоните нам",
        description: "Принимаем заявку и согласовываем время визита",
        icon: "ri-phone-line"
      },
      {
        number: 2,
        title: "Диагностика и ремонт",
        description: "Приезжаем, определяем причину и устраняем неисправность на месте",
        icon: "ri-tools-line"
      },
      {
        number: 3,
        title: "Гарантия 2 года",
        description: "Выдаём гарантийный талон на все виды работ",
        icon: "ri-shield-check-line"
      }
    ]}
    ctaText="Вызвать мастера"
    ctaLink="#lid-form"
  />

  <Testimonials2Material
    id="testimonials"
    heading="Отзывы наших клиентов"
    subheading="Более 5000 отремонтированных стиральных машин за 9 лет работы"
    testimonials={[
      {
        name: "Ольга Петрова",
        date: "25 октября 2024",
        rating: 5,
        text: "Замечательный сервис! Стиральная машина Samsung перестала отжимать. Мастер приехал через 20 минут, быстро нашёл проблему и починил. Цена полностью соответствует заявленной. Рекомендую!"
      },
      {
        name: "Андрей Смирнов",
        date: "18 октября 2024",
        rating: 5,
        text: "Профессионалы своего дела! LG не сливала воду. Приехали в день обращения, заменили помпу за час. Дали гарантию на 2 года. Работает отлично, спасибо!"
      },
      {
        name: "Мария Кузнецова",
        date: "12 октября 2024",
        rating: 5,
        text: "Очень довольна работой! Bosch сильно шумела при отжиме. Мастер заменил подшипники и амортизаторы. Теперь машинка работает как новая. Цены честные, без переплат."
      },
      {
        name: "Сергей Волков",
        date: "5 октября 2024",
        rating: 5,
        text: "Отличный сервис! Indesit не включалась совсем. Думал, что придётся покупать новую. Мастера отремонтировали модуль управления, всё работает. Гарантию дали на 2 года. Молодцы!"
      }
    ]}
  />

  <FAQ2Material
    id="faq"
    heading="Часто задаваемые вопросы"
    subheading="Не нашли ответ? Звоните: +7 (812) 213-07-14"
    faqs={[
      {
        question: "Сколько стоит выезд мастера?",
        answer: "Выезд мастера бесплатный при условии выполнения ремонта."
      },
      {
        question: "Какие бренды стиральных машин вы ремонтируете?",
        answer: "Мы ремонтируем все бренды: Samsung, LG, Bosch, Siemens, Indesit, Атлант, Liebherr, Gorenje и другие."
      },
      {
        question: "Сколько времени занимает ремонт?",
        answer: "В 80% случаев ремонт выполняется в день обращения."
      },
      {
        question: "Предоставляете ли вы гарантию?",
        answer: "Да, гарантия 2 года на все виды работ и установленные запчасти."
      },
      {
        question: "Работаете ли вы в выходные?",
        answer: "Да, работаем без выходных и праздников. Ежедневно с 8:00 до 24:00."
      }
    ]}
  />

  <Footer2Material
    logo="ТехСпец"
    logoIcon="ri-tools-line"
    phone="+7 (812) 213-07-14"
    email="info@techspec-spb.ru"
    address="Санкт-Петербург, ул. Моховая, 26"
    workingHours="Ежедневно с 8:00 до 24:00"
    description="Мы занимаемся ремонтом стиральных машин более 15 лет. В нашей команде работают сертифицированные мастера с опытом работы от 10 лет. Используем только оригинальные запчасти с гарантией."
    menuItems={[
      { label: 'Главная', href: '#' },
      { label: 'Услуги', href: '#services' },
      { label: 'Преимущества', href: '#benefits' },
      { label: 'Как работаем', href: '#how-it-works' },
      { label: 'Отзывы', href: '#testimonials' },
      { label: 'Вопросы', href: '#faq' }
    ]}
    ctaText="Вызвать мастера"
    ctaHref="#lid-form"
    copyrightText="© 2024 ТехСпец. Все права защищены"
    companyDetails={{
      legalForm: "ИП Милославская Алла Сергеевна",
      inn: "421501977963",
      ogrn: "318420500068613"
    }}
    mapUrl="https://yandex.ru/map-widget/v1/?um=constructor%3Afb5bcb627b07a192c4917d0eda9087e3d1fd3d75ac9463d8cdb043e5b160b296&source=constructor"
  />

</BaseLayout>
