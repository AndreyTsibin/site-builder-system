---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header1 from '../components/sections/header/Header1.astro';
import Header2 from '../components/sections/header/Header2.astro';
import Header3 from '../components/sections/header/Header3.astro';
---

<BaseLayout title="Site Builder 2.0 | Header Demo">

  <!-- Header1 - Simple Logo + Menu + Phone -->
  <Header1
    logo="РемонтТех"
    phone="+7 (495) 123-45-67"
  />

  <!-- Demo Content for Header1 -->
  <section class="py-16 md:py-20 lg:py-24 bg-gray-50" id="services">
    <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-8">
        Header 1 — Simple Logo + Menu + Phone
      </h2>
      <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto">
        Классический вариант с логотипом слева, меню по центру и контактами справа.
        Sticky позиционирование и slide-in sidebar на мобильных устройствах.
      </p>
    </div>
  </section>

  <!-- Spacer between demos -->
  <div class="h-screen"></div>

  <!-- Header2 - Logo + Menu + Promo Banner -->
  <Header2
    logo="РемонтТех"
    phone="+7 (495) 123-45-67"
    promoBanner="Бесплатная диагностика при ремонте!"
    promoBannerBg="bg-green-600"
  />

  <!-- Demo Content for Header2 -->
  <section class="py-16 md:py-20 lg:py-24 bg-blue-50" id="testimonials">
    <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-8">
        Header 2 — Logo + Menu + Promo Banner
      </h2>
      <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto">
        Вариант с промо-баннером сверху для акций и спецпредложений.
        Яркий баннер привлекает внимание к выгодным условиям.
      </p>
    </div>
  </section>

  <!-- Spacer between demos -->
  <div class="h-screen"></div>

  <!-- Header3 - Centered Logo -->
  <Header3
    logo="РемонтТех"
    phone="+7 (495) 123-45-67"
  />

  <!-- Demo Content for Header3 -->
  <section class="py-16 md:py-20 lg:py-24 bg-green-50" id="contacts">
    <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-8">
        Header 3 — Centered Logo
      </h2>
      <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto">
        Премиальный вариант с центрированным логотипом и симметричным расположением элементов.
        Создает более изысканный и сбалансированный вид.
      </p>
    </div>
  </section>

  <!-- Spacer for footer -->
  <div class="h-screen"></div>

</BaseLayout>
