---
import BaseLayout from '../layouts/BaseLayout.astro';

// Portfolio Sections
import Portfolio2 from '../components/sections/portfolio/Portfolio2.astro';
import Portfolio3 from '../components/sections/portfolio/Portfolio3.astro';
---

<BaseLayout title="Site Builder 2.0 - Portfolio Demo">

  <!-- ========================================
       PORTFOLIO SECTIONS (2 variants)
       ======================================== -->

  <!-- Portfolio2: Multi-Card Carousel -->
  <Portfolio2
    title="Наши работы"
    subtitle="Примеры успешно выполненных ремонтов"
    items={[
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт холодильника Samsung",
        category: "Холодильники",
        description: "Замена компрессора и заправка хладагента"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Восстановление стиральной машины Bosch",
        category: "Стиральные машины",
        description: "Ремонт электроники и замена подшипников"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт духового шкафа Electrolux",
        category: "Духовые шкафы",
        description: "Замена ТЭНа и настройка терморегулятора"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт посудомоечной машины Siemens",
        category: "Посудомойки",
        description: "Замена циркуляционного насоса"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт варочной панели Gorenje",
        category: "Варочные панели",
        description: "Замена сенсорной панели управления"
      },
      {
        image: "/images/placeholder-img.jpg",
        title: "Ремонт микроволновки LG",
        category: "Микроволновки",
        description: "Замена магнетрона и диода"
      }
    ]}
    slidesPerView={{ mobile: 1, tablet: 2, desktop: 3 }}
    spaceBetween={24}
    autoPlay={true}
    autoPlayDelay={3000}
    bgColor="white"
  />

  <!-- Portfolio3: Thumbnail Navigation Carousel -->
  <Portfolio3
    title="Примеры наших работ"
    subtitle="Качество, подтвержденное фотографиями"
    items={[
      {
        image: "/images/placeholder-img.jpg",
        thumbnail: "/images/placeholder-img.jpg",
        title: "Комплексный ремонт холодильника",
        category: "Холодильники",
        description: "Замена компрессора, заправка фреоном, герметизация системы охлаждения."
      },
      {
        image: "/images/placeholder-img.jpg",
        thumbnail: "/images/placeholder-img.jpg",
        title: "Ремонт стиральной машины премиум-класса",
        category: "Стиральные машины",
        description: "Восстановление платы управления, замена подшипников барабана."
      },
      {
        image: "/images/placeholder-img.jpg",
        thumbnail: "/images/placeholder-img.jpg",
        title: "Ремонт встроенного духового шкафа",
        category: "Духовые шкафы",
        description: "Замена нагревательных элементов, калибровка температурных датчиков."
      },
      {
        image: "/images/placeholder-img.jpg",
        thumbnail: "/images/placeholder-img.jpg",
        title: "Восстановление посудомоечной машины",
        category: "Посудомойки",
        description: "Замена помпы, очистка системы слива, замена уплотнителей."
      },
      {
        image: "/images/placeholder-img.jpg",
        thumbnail: "/images/placeholder-img.jpg",
        title: "Ремонт индукционной варочной панели",
        category: "Варочные панели",
        description: "Замена сенсорной панели, ремонт блока питания."
      }
    ]}
    bgColor="gray-50"
  />

</BaseLayout>
