---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ1 from '../components/sections/faq/FAQ1.astro';
import FAQ2 from '../components/sections/faq/FAQ2.astro';
import FAQ3 from '../components/sections/faq/FAQ3.astro';

// FAQ data template (used in all variants)
const faqData = [
  {
    question: 'Сколько стоит ремонт?',
    answer: 'Стоимость ремонта зависит от типа неисправности и модели техники. Диагностика бесплатная. После осмотра мастер озвучит точную цену. Средняя стоимость ремонта от 1500₽.'
  },
  {
    question: 'Как быстро приедет мастер?',
    answer: 'В большинстве случаев мастер приезжает в течение 2 часов после вашего звонка. Для срочных вызовов возможен выезд в течение 30-60 минут. Вы можете выбрать удобное время.'
  },
  {
    question: 'Какая гарантия на ремонт?',
    answer: 'Мы предоставляем официальную гарантию от 6 до 12 месяцев на все виды работ и установленные запчасти. Гарантия оформляется документально с актом выполненных работ.'
  },
  {
    question: 'Ремонтируете ли вы технику на дому?',
    answer: 'Да, 95% ремонтов мы выполняем на дому у клиента. Мастер приезжает со всеми необходимыми инструментами и запчастями. Только в сложных случаях может потребоваться доставка техники в сервис.'
  },
  {
    question: 'Какие способы оплаты вы принимаете?',
    answer: 'Мы принимаем наличные, банковские карты, переводы по номеру телефона (СБП). Оплата производится после завершения ремонта и проверки работы техники.'
  }
];
---

<BaseLayout title="Site Builder 2.0 | FAQ Demo">

  <!-- FAQ1 - Centered Single Column -->
  <FAQ1
    heading="Часто задаваемые вопросы"
    subheading="Ответы на самые популярные вопросы о ремонте техники"
    faqs={faqData}
  />

  <!-- FAQ2 - Two-Column with Image -->
  <FAQ2
    heading="Остались вопросы?"
    subheading="Мы собрали ответы на самые частые вопросы наших клиентов"
    faqs={faqData}
  />

  <!-- FAQ3 - Two-Column Split Layout -->
  <FAQ3
    heading="Популярные вопросы"
    subheading="Всё что нужно знать о ремонте бытовой техники"
    faqs={faqData}
  />
</BaseLayout>
