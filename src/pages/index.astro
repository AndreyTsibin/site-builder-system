---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowItWorks1 from '../components/sections/how-it-works/HowItWorks1.astro';
import HowItWorks2 from '../components/sections/how-it-works/HowItWorks2.astro';
import HowItWorks3 from '../components/sections/how-it-works/HowItWorks3.astro';
---

<BaseLayout title="Site Builder 2.0 | How It Works Demo">

  <!-- HowItWorks1 - Vertical Timeline -->
  <HowItWorks1
    heading="Как мы работаем"
    subheading="Простой и прозрачный процесс ремонта вашей техники"
    ctaText="Вызвать мастера"
    ctaLink="#"
    steps={[
      {
        number: 1,
        icon: 'ri-phone-line',
        title: 'Звонок и консультация',
        description: 'Позвоните нам или оставьте заявку онлайн. Мастер проконсультирует вас по телефону и озвучит примерную стоимость ремонта.'
      },
      {
        number: 2,
        icon: 'ri-car-line',
        title: 'Выезд и диагностика',
        description: 'Мастер приедет в удобное для вас время. Проведёт бесплатную диагностику и точно определит причину поломки.'
      },
      {
        number: 3,
        icon: 'ri-tools-line',
        title: 'Ремонт и замена деталей',
        description: 'После вашего согласия мастер приступит к ремонту. Используем только оригинальные запчасти с гарантией.'
      },
      {
        number: 4,
        icon: 'ri-checkbox-circle-line',
        title: 'Проверка и гарантия',
        description: 'Тестируем работу техники при вас. Выдаём гарантию на выполненные работы сроком до 12 месяцев.'
      }
    ]}
  />

  <!-- HowItWorks2 - Horizontal Cards with Arrows -->
  <HowItWorks2
    heading="Этапы работы"
    subheading="От звонка до готовой техники — всего 4 простых шага"
    ctaText="Заказать ремонт"
    ctaLink="#"
    steps={[
      {
        number: 1,
        icon: 'ri-customer-service-line',
        title: 'Заявка',
        description: 'Оставьте заявку по телефону или через форму на сайте. Опишите проблему с техникой.'
      },
      {
        number: 2,
        icon: 'ri-map-pin-line',
        title: 'Диагностика',
        description: 'Мастер приедет в течение 2 часов, проведёт диагностику и озвучит точную стоимость ремонта.'
      },
      {
        number: 3,
        icon: 'ri-settings-3-line',
        title: 'Ремонт',
        description: 'Устраняем неисправность на месте. В 95% случаев ремонт занимает от 30 минут до 2 часов.'
      },
      {
        number: 4,
        icon: 'ri-shield-check-line',
        title: 'Гарантия',
        description: 'Выдаём гарантию до 12 месяцев на все виды работ и установленные детали.'
      }
    ]}
  />

  <!-- HowItWorks3 - Icon Grid (Minimalist) -->
  <HowItWorks3
    heading="Процесс ремонта"
    subheading="Всё просто и понятно"
    steps={[
      {
        number: 1,
        icon: 'ri-phone-fill',
        title: 'Звонок',
        description: 'Опишите проблему по телефону, получите предварительную оценку стоимости'
      },
      {
        number: 2,
        icon: 'ri-search-line',
        title: 'Осмотр',
        description: 'Мастер проведёт диагностику и озвучит точную цену ремонта'
      },
      {
        number: 3,
        icon: 'ri-hammer-line',
        title: 'Ремонт',
        description: 'Устраняем поломку с использованием оригинальных запчастей'
      },
      {
        number: 4,
        icon: 'ri-verified-badge-line',
        title: 'Готово',
        description: 'Проверяем работу техники и выдаём гарантию на 12 месяцев'
      }
    ]}
  />
</BaseLayout>
