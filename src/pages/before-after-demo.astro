---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter1 from '../components/sections/before-after/BeforeAfter1.astro';
import BeforeAfter2 from '../components/sections/before-after/BeforeAfter2.astro';
import BeforeAfter3 from '../components/sections/before-after/BeforeAfter3.astro';
---

<BaseLayout title="Before/After Sections Demo">

  <!-- BeforeAfter1: Single Comparison -->
  <BeforeAfter1
    title="Результаты наших работ"
    subtitle="Мы гарантируем качество каждого ремонта"
    imageBefore="/images/placeholder-img.jpg"
    imageAfter="/images/placeholder-img.jpg"
    serviceLabel="Ремонт холодильника Bosch"
    description="Восстановление компрессора, замена уплотнителя, 1 день работы"
    ctaText="Заказать ремонт"
  />

  <!-- BeforeAfter2: Grid of Comparisons -->
  <BeforeAfter2
    title="Наши работы"
    subtitle="Примеры выполненных ремонтов с гарантией качества"
    comparisons={[
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт холодильника Samsung",
        description: "Замена компрессора, 2 дня"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт стиральной машины LG",
        description: "Замена подшипников, 1 день"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт посудомоечной машины Bosch",
        description: "Замена насоса, 3 часа"
      }
    ]}
    ctaText="Заказать ремонт"
  />

  <!-- BeforeAfter3: Featured with Thumbnails -->
  <BeforeAfter3
    title="Кейс: Ремонт премиум-техники"
    subtitle="Подробный пример работы с отзывом клиента"
    featured={{
      imageBefore: "/images/placeholder-img.jpg",
      imageAfter: "/images/placeholder-img.jpg",
      serviceName: "Ремонт холодильника Liebherr",
      description: "Полная диагностика, замена компрессора и электроники, 2 дня работы"
    }}
    gallery={[
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт посудомойки Miele",
        description: "Замена насоса и фильтров"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт духовки Gorenje",
        description: "Замена термостата"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт винного шкафа",
        description: "Замена компрессора"
      },
      {
        imageBefore: "/images/placeholder-img.jpg",
        imageAfter: "/images/placeholder-img.jpg",
        serviceName: "Ремонт кофемашины Jura",
        description: "Чистка и замена уплотнителей"
      }
    ]}
    testimonial={{
      text: "Спасибо огромное мастеру Сергею! Отремонтировал холодильник Liebherr за 2 дня. Работает как новый, гарантия 1 год. Рекомендую!",
      author: "Елена Петрова, Москва",
      rating: 5
    }}
    ctaText="Заказать такой же ремонт"
  />

</BaseLayout>
