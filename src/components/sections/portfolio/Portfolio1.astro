---
/**
 * Portfolio1: Fullwidth Slider with Captions
 *
 * One image visible at a time, full-width carousel with navigation.
 * Features: Swiper.js carousel, caption overlay, arrow navigation, dots.
 * Best for: Hero portfolio showcase, featured work gallery.
 */

interface PortfolioItem {
  image: string; // Path to portfolio image
  title: string; // "Ремонт кухни в ЖК Новый"
  category: string; // "Кухонная техника"
  description?: string; // Optional description
  link?: string; // Optional link to case study
}

interface Props {
  title: string; // "Наши работы"
  subtitle?: string; // "Портфолио выполненных проектов"
  items: PortfolioItem[]; // 6-12 items
  autoPlay?: boolean; // Auto-play carousel
  autoPlayDelay?: number; // Delay in milliseconds (default: 5000)
  showNavigation?: boolean; // Show arrow navigation (default: true)
  showDots?: boolean; // Show pagination dots (default: true)
  bgColor?: string; // "white" | "gray-50"
}

const {
  title,
  subtitle,
  items,
  autoPlay = false,
  autoPlayDelay = 5000,
  showNavigation = true,
  showDots = true,
  bgColor = "white"
} = Astro.props;
---

<section class={`py-16 md:py-20 lg:py-24 bg-${bgColor}`}>
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    {/* Swiper Carousel */}
    <div class="relative">
      <div class="swiper portfolio1-swiper">
        <div class="swiper-wrapper">
          {items.map((item) => (
            <div class="swiper-slide">
              {/* Portfolio Card */}
              <div class="relative rounded-2xl overflow-hidden shadow-2xl group" style="aspect-ratio: 16/9;">
                {/* Image */}
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />

                {/* Overlay with Caption */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-6 md:p-8">
                  {/* Category Badge */}
                  <div class="mb-3">
                    <span class="inline-block px-4 py-1 bg-blue-700 text-white text-sm font-semibold rounded-full">
                      {item.category}
                    </span>
                  </div>

                  {/* Title */}
                  <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-2">
                    {item.title}
                  </h3>

                  {/* Description */}
                  {item.description && (
                    <p class="text-base md:text-lg text-gray-200 mb-4">
                      {item.description}
                    </p>
                  )}

                  {/* Link (optional) */}
                  {item.link && (
                    <div>
                      <a
                        href={item.link}
                        class="inline-flex items-center gap-2 text-white font-semibold hover:text-blue-300 transition-colors"
                      >
                        <span>Подробнее</span>
                        <i class="ri-arrow-right-line"></i>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Navigation */}
      {(showNavigation || showDots) && (
        <div class="mt-8">
          <div class="flex items-center justify-center gap-6 max-w-max mx-auto">
            {showNavigation && (
              <button class="swiper-button-prev-portfolio1 portfolio-nav-button1">
                <i class="ri-arrow-left-s-line"></i>
              </button>
            )}

            {showDots && (
              <div class="swiper-pagination-portfolio1"></div>
            )}

            {showNavigation && (
              <button class="swiper-button-next-portfolio1 portfolio-nav-button1">
                <i class="ri-arrow-right-s-line"></i>
              </button>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Swiper custom styles */
  .portfolio1-swiper {
    padding-bottom: 0;
  }

  /* Hide default Swiper navigation */
  .portfolio1-swiper :global(.swiper-button-prev),
  .portfolio1-swiper :global(.swiper-button-next) {
    display: none;
  }

  /* Custom navigation buttons */
  .portfolio-nav-button1 {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e40af; /* blue-700 */
    color: white;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    font-size: 24px;
    flex-shrink: 0;
  }

  .portfolio-nav-button1:hover:not(:disabled) {
    background: #1e3a8a; /* blue-800 */
    transform: scale(1.1);
  }

  .portfolio-nav-button1:disabled {
    background: #d1d5db; /* gray-300 */
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Custom pagination */
  .swiper-pagination-portfolio1 {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
  }

  .swiper-pagination-portfolio1 :global(.swiper-pagination-bullet) {
    width: 10px;
    height: 10px;
    background: #9ca3af; /* gray-400 */
    opacity: 1;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .swiper-pagination-portfolio1 :global(.swiper-pagination-bullet-active) {
    background: #1e40af; /* blue-700 */
    width: 32px;
    border-radius: 5px;
  }
</style>

<script define:vars={{ autoPlay, autoPlayDelay }}>
  // Initialize Swiper
  import('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs').then((module) => {
    const Swiper = module.default;

    new Swiper('.portfolio1-swiper', {
      slidesPerView: 1,
      spaceBetween: 0,
      loop: true,
      autoplay: autoPlay ? {
        delay: autoPlayDelay,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      } : false,
      navigation: {
        nextEl: '.swiper-button-next-portfolio1',
        prevEl: '.swiper-button-prev-portfolio1',
      },
      pagination: {
        el: '.swiper-pagination-portfolio1',
        clickable: true,
      },
    });
  });
</script>
