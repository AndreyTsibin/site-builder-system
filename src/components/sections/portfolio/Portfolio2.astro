---
/**
 * Portfolio2: Multi-Card Carousel
 *
 * Show 3 images at once on desktop, 2 on tablet, 1 on mobile.
 * Features: Swiper.js multi-card layout, hover zoom effect, caption below.
 * Best for: Portfolio grid with scrollable cards, multiple visible items.
 */

interface PortfolioItem {
  image: string; // Path to portfolio image
  title: string; // "Ремонт кухни в ЖК Новый"
  category: string; // "Кухонная техника"
  description?: string; // Optional description
  link?: string; // Optional link to case study
}

interface Props {
  title: string; // "Наши работы"
  subtitle?: string; // "Портфолио выполненных проектов"
  items: PortfolioItem[]; // 6-12 items
  slidesPerView?: {
    mobile: number; // 1
    tablet: number; // 2
    desktop: number; // 3
  };
  spaceBetween?: number; // Gap in pixels (default: 24)
  autoPlay?: boolean; // Auto-play carousel
  autoPlayDelay?: number; // Delay in milliseconds (default: 5000)
  bgColor?: string; // "white" | "gray-50"
}

const {
  title,
  subtitle,
  items,
  slidesPerView = { mobile: 1, tablet: 2, desktop: 3 },
  spaceBetween = 24,
  autoPlay = false,
  autoPlayDelay = 5000,
  bgColor = "white"
} = Astro.props;
---

<section class={`py-16 md:py-20 lg:py-24 bg-${bgColor}`}>
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    {/* Swiper Carousel */}
    <div class="relative">
      <div class="swiper portfolio2-swiper">
        <div class="swiper-wrapper">
          {items.map((item) => (
            <div class="swiper-slide">
              {/* Portfolio Card */}
              <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 group">
                {/* Image */}
                <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  />

                  {/* Category Badge */}
                  <div class="absolute top-4 left-4">
                    <span class="inline-block px-4 py-2 bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-lg">
                      {item.category}
                    </span>
                  </div>

                  {/* Hover Overlay */}
                  <div class="absolute inset-0 bg-blue-700/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    {item.link ? (
                      <a
                        href={item.link}
                        class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg hover:bg-gray-100 transition-colors"
                      >
                        <span>Подробнее</span>
                        <i class="ri-arrow-right-line"></i>
                      </a>
                    ) : (
                      <div class="text-white text-center px-4">
                        <i class="ri-eye-line text-4xl mb-2"></i>
                        <p class="text-lg font-semibold">Посмотреть детали</p>
                      </div>
                    )}
                  </div>
                </div>

                {/* Content */}
                <div class="p-6">
                  {/* Title */}
                  <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
                    {item.title}
                  </h3>

                  {/* Description */}
                  {item.description && (
                    <p class="text-base text-gray-600">
                      {item.description}
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Navigation */}
      <div class="mt-8">
        <div class="flex items-center justify-center gap-6">
          <button class="swiper-button-prev-portfolio2 portfolio-nav-button2">
            <i class="ri-arrow-left-s-line"></i>
          </button>

          <div class="swiper-pagination-portfolio2"></div>

          <button class="swiper-button-next-portfolio2 portfolio-nav-button2">
            <i class="ri-arrow-right-s-line"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Swiper custom styles */
  .portfolio2-swiper {
    padding-bottom: 0;
  }

  /* Hide default Swiper navigation */
  .portfolio2-swiper :global(.swiper-button-prev),
  .portfolio2-swiper :global(.swiper-button-next) {
    display: none;
  }

  /* Custom navigation buttons */
  .portfolio-nav-button2 {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e40af; /* blue-700 */
    color: white;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    font-size: 24px;
    flex-shrink: 0;
  }

  .portfolio-nav-button2:hover:not(:disabled) {
    background: #1e3a8a; /* blue-800 */
    transform: scale(1.1);
  }

  .portfolio-nav-button2:disabled {
    background: #d1d5db; /* gray-300 */
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Custom pagination */
  .swiper-pagination-portfolio2 {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
  }

  .swiper-pagination-portfolio2 :global(.swiper-pagination-bullet) {
    width: 10px;
    height: 10px;
    background: #9ca3af; /* gray-400 */
    opacity: 1;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .swiper-pagination-portfolio2 :global(.swiper-pagination-bullet-active) {
    background: #1e40af; /* blue-700 */
    width: 32px;
    border-radius: 5px;
  }
</style>

<script define:vars={{ slidesPerView, spaceBetween, autoPlay, autoPlayDelay }}>
  // Initialize Swiper
  import('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs').then((module) => {
    const Swiper = module.default;

    new Swiper('.portfolio2-swiper', {
      slidesPerView: slidesPerView.mobile,
      spaceBetween: spaceBetween,
      loop: true,
      autoplay: autoPlay ? {
        delay: autoPlayDelay,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      } : false,
      navigation: {
        nextEl: '.swiper-button-next-portfolio2',
        prevEl: '.swiper-button-prev-portfolio2',
      },
      pagination: {
        el: '.swiper-pagination-portfolio2',
        clickable: true,
      },
      breakpoints: {
        // Mobile: 1 slide
        320: {
          slidesPerView: slidesPerView.mobile,
          spaceBetween: 16,
        },
        // Tablet: 2 slides
        768: {
          slidesPerView: slidesPerView.tablet,
          spaceBetween: spaceBetween,
        },
        // Desktop: 3 slides
        1024: {
          slidesPerView: slidesPerView.desktop,
          spaceBetween: spaceBetween,
        },
      },
    });
  });
</script>
