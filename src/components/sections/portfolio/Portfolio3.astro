---
/**
 * Portfolio3: Thumbnail Navigation Carousel
 *
 * Main large image at top with thumbnail strip below for navigation.
 * Features: Swiper.js with thumbs, click thumbnail to change main image.
 * Best for: Detailed portfolio gallery with easy navigation.
 */

interface PortfolioItem {
  image: string; // Path to portfolio image
  title: string; // "Ремонт кухни в ЖК Новый"
  category: string; // "Кухонная техника"
  description?: string; // Optional description
  link?: string; // Optional link to case study
}

interface Props {
  title: string; // "Наши работы"
  subtitle?: string; // "Портфолио выполненных проектов"
  items: PortfolioItem[]; // 6-12 items
  thumbnailCount?: number; // How many thumbnails visible at once (default: 5)
  bgColor?: string; // "white" | "gray-50"
}

const {
  title,
  subtitle,
  items,
  thumbnailCount = 5,
  bgColor = "white"
} = Astro.props;
---

<section class={`py-16 md:py-20 lg:py-24 bg-${bgColor}`}>
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    {/* Main Gallery */}
    <div class="relative">
      {/* Main Swiper */}
      <div class="swiper portfolio3-main mb-6">
        <div class="swiper-wrapper">
          {items.map((item) => (
            <div class="swiper-slide">
              {/* Main Portfolio Card */}
              <div class="rounded-2xl overflow-hidden border-2 border-gray-200 hover:border-blue-700 transition-colors duration-300">
                {/* Image Container */}
                <div class="relative" style="aspect-ratio: 4/3;">
                  {/* Image */}
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover"
                  />

                  {/* Category Badge - Always Visible */}
                  <div class="absolute top-4 left-4">
                    <span class="inline-block px-3 py-1 md:px-4 md:py-2 bg-blue-700 text-white text-xs md:text-sm font-semibold rounded-xl">
                      {item.category}
                    </span>
                  </div>

                  {/* Desktop Overlay - Hidden on Mobile */}
                  <div class="hidden md:flex absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex-col justify-end p-6 lg:p-8">
                    {/* Title */}
                    <h3 class="text-2xl lg:text-3xl xl:text-4xl font-bold text-white mb-2">
                      {item.title}
                    </h3>

                    {/* Description */}
                    {item.description && (
                      <p class="text-base lg:text-lg text-gray-200 mb-4">
                        {item.description}
                      </p>
                    )}

                    {/* Link (optional) */}
                    {item.link && (
                      <div>
                        <a
                          href={item.link}
                          class="inline-flex items-center gap-2 text-white font-semibold hover:text-blue-300 transition-colors"
                        >
                          <span>Подробнее</span>
                          <i class="ri-arrow-right-line"></i>
                        </a>
                      </div>
                    )}
                  </div>
                </div>

                {/* Mobile Content - Below Image */}
                <div class="md:hidden bg-white p-4">
                  {/* Title */}
                  <h3 class="text-xl font-bold text-gray-900 mb-2">
                    {item.title}
                  </h3>

                  {/* Description */}
                  {item.description && (
                    <p class="text-sm text-gray-600">
                      {item.description}
                    </p>
                  )}

                  {/* Link (optional) */}
                  {item.link && (
                    <div class="mt-3">
                      <a
                        href={item.link}
                        class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:text-blue-800 transition-colors"
                      >
                        <span>Подробнее</span>
                        <i class="ri-arrow-right-line"></i>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Thumbnail Navigation */}
      <div class="relative px-12">
        <div class="swiper portfolio3-thumbs">
          <div class="swiper-wrapper">
            {items.map((item) => (
              <div class="swiper-slide">
                {/* Thumbnail Card */}
                <div class="relative rounded-xl overflow-hidden cursor-pointer transition-all duration-300 border-2 border-transparent hover:border-blue-700" style="aspect-ratio: 4/3;">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover"
                  />
                  {/* Overlay on inactive */}
                  <div class="absolute inset-0 bg-black/40 transition-opacity duration-300"></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Thumbnail Navigation Arrows */}
        <button class="swiper-button-prev-portfolio3-thumbs absolute left-0 top-1/2 -translate-y-1/2 z-10">
          <i class="ri-arrow-left-s-line"></i>
        </button>
        <button class="swiper-button-next-portfolio3-thumbs absolute right-0 top-1/2 -translate-y-1/2 z-10">
          <i class="ri-arrow-right-s-line"></i>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Main swiper */
  .portfolio3-main {
    margin-bottom: 24px;
  }

  /* Thumbnail swiper */
  .portfolio3-thumbs {
    padding: 4px 0;
  }

  /* Active thumbnail styling */
  .portfolio3-thumbs :global(.swiper-slide-thumb-active) {
    opacity: 1;
  }

  .portfolio3-thumbs :global(.swiper-slide-thumb-active) > div {
    border-color: #1e40af !important; /* blue-700 */
  }

  .portfolio3-thumbs :global(.swiper-slide-thumb-active) .absolute {
    opacity: 0 !important;
  }

  /* Thumbnail navigation buttons */
  .swiper-button-prev-portfolio3-thumbs,
  .swiper-button-next-portfolio3-thumbs {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e40af; /* blue-700 */
    color: white;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    font-size: 20px;
  }

  .swiper-button-prev-portfolio3-thumbs:hover:not(:disabled),
  .swiper-button-next-portfolio3-thumbs:hover:not(:disabled) {
    background: #1e3a8a; /* blue-800 */
    transform: scale(1.1);
  }

  .swiper-button-prev-portfolio3-thumbs:disabled,
  .swiper-button-next-portfolio3-thumbs:disabled {
    background: #d1d5db; /* gray-300 */
    cursor: not-allowed;
    opacity: 0.5;
  }
</style>

<script define:vars={{ thumbnailCount }}>
  // Initialize Swiper
  import('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs').then((module) => {
    const Swiper = module.default;

    // Initialize thumbnail swiper first
    const swiperThumbs = new Swiper('.portfolio3-thumbs', {
      slidesPerView: 3,
      spaceBetween: 12,
      watchSlidesProgress: true,
      freeMode: true,
      navigation: {
        nextEl: '.swiper-button-next-portfolio3-thumbs',
        prevEl: '.swiper-button-prev-portfolio3-thumbs',
      },
      breakpoints: {
        320: {
          slidesPerView: 3,
          spaceBetween: 8,
        },
        640: {
          slidesPerView: 4,
          spaceBetween: 12,
        },
        768: {
          slidesPerView: thumbnailCount,
          spaceBetween: 16,
        },
        1024: {
          slidesPerView: Math.min(thumbnailCount, 7),
          spaceBetween: 20,
        },
      },
    });

    // Initialize main swiper with thumbs
    new Swiper('.portfolio3-main', {
      slidesPerView: 1,
      spaceBetween: 0,
      loop: true,
      thumbs: {
        swiper: swiperThumbs,
      },
    });
  });
</script>
