---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  subheading?: string;
  faqs: FAQItem[];
}

const { heading, subheading, faqs } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gradient-to-b from-blue-50 to-white">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Left Column: Heading + Subheading -->
      <div class="lg:sticky lg:top-8 lg:self-start">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          {heading}
        </h2>
        {subheading && (
          <p class="text-lg md:text-xl text-gray-600">
            {subheading}
          </p>
        )}
      </div>

      <!-- Right Column: FAQ Accordion -->
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details class="group bg-white rounded-lg border-2 border-gray-200 overflow-hidden transition-all hover:border-blue-400" name="faq-accordion-3">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-lg text-gray-900 list-none">
              <span>{faq.question}</span>
              <i class="ri-arrow-down-s-line text-2xl text-blue-700 transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="px-6 pb-6 pt-2 text-base md:text-lg text-gray-600 border-t border-gray-100">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Close other accordions when one is opened (one open at a time)
  document.addEventListener('DOMContentLoaded', () => {
    const details = document.querySelectorAll('details[name="faq-accordion-3"]');

    details.forEach((targetDetail) => {
      targetDetail.addEventListener('click', () => {
        details.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute('open');
          }
        });
      });
    });
  });
</script>
