---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  subheading?: string;
  faqs: FAQItem[];
}

const { heading, subheading, faqs } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- FAQ Accordion (Centered) -->
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-lg border-2 border-gray-200 overflow-hidden transition-all hover:border-blue-400" name="faq-accordion">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-lg text-gray-900 list-none">
            <span>{faq.question}</span>
            <i class="ri-arrow-down-s-line text-2xl text-blue-700 transition-transform group-open:rotate-180"></i>
          </summary>
          <div class="px-6 pb-6 pt-2 text-base md:text-lg text-gray-600 border-t border-gray-100">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Close other accordions when one is opened (one open at a time)
  document.addEventListener('DOMContentLoaded', () => {
    const details = document.querySelectorAll('details[name="faq-accordion"]');

    details.forEach((targetDetail) => {
      targetDetail.addEventListener('click', () => {
        details.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute('open');
          }
        });
      });
    });
  });
</script>
