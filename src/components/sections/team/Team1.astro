---
/**
 * Team1: Grid with Photo Cards
 *
 * 3-column responsive grid with team member cards.
 * Features: Photo, name, role, experience, bio, specializations/certifications.
 * Best for: Showcasing team expertise, building trust with service businesses.
 */

interface TeamMember {
  photo: string; // Path to team member photo
  name: string; // "Иван Петров"
  role: string; // "Мастер по ремонту холодильников"
  experience: string; // "15 лет опыта"
  bio: string; // Short 1-2 sentence bio
  specializations?: string[]; // ["Bosch", "Siemens", "Samsung"]
  certifications?: string[]; // ["Сертификат Bosch", "Мастер года 2024"]
}

interface Props {
  title: string; // "Наши мастера"
  subtitle?: string; // "Опытные специалисты с многолетним стажем"
  members: TeamMember[]; // 3-8 members
  bgColor?: string; // "white" | "gray-50"
}

const {
  title,
  subtitle,
  members,
  bgColor = "white"
} = Astro.props;
---

<section class={`py-16 md:py-20 lg:py-24 bg-${bgColor}`}>
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    {/* Team Grid */}
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 lg:gap-12">
      {members.map((member) => (
        <div class="bg-white rounded-2xl overflow-hidden border-2 border-gray-200 transition-all duration-300 group">
          {/* Photo */}
          <div class="relative overflow-hidden" style="aspect-ratio: 3/4;">
            <img
              src={member.photo}
              alt={member.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            {/* Experience Badge */}
            <div class="absolute top-4 right-4">
              <span class="inline-block px-4 py-2 bg-blue-700 text-white text-sm font-semibold rounded-xl">
                {member.experience}
              </span>
            </div>
          </div>

          {/* Content */}
          <div class="p-6">
            {/* Name */}
            <h3 class="text-2xl font-bold text-gray-900 mb-1">
              {member.name}
            </h3>

            {/* Role */}
            <p class="text-base text-blue-700 font-semibold mb-4">
              {member.role}
            </p>

            {/* Bio */}
            <p class="text-base text-gray-600 mb-4">
              {member.bio}
            </p>

            {/* Specializations */}
            {member.specializations && member.specializations.length > 0 && (
              <div class="mb-4">
                <p class="text-sm font-semibold text-gray-700 mb-2">
                  Специализация:
                </p>
                <div class="flex flex-wrap gap-2">
                  {member.specializations.map((spec) => (
                    <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-lg">
                      {spec}
                    </span>
                  ))}
                </div>
              </div>
            )}

            {/* Certifications */}
            {member.certifications && member.certifications.length > 0 && (
              <div>
                <p class="text-sm font-semibold text-gray-700 mb-2">
                  Сертификаты:
                </p>
                <div class="flex flex-col gap-1">
                  {member.certifications.map((cert) => (
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                      <i class="ri-award-line text-blue-700"></i>
                      <span>{cert}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
