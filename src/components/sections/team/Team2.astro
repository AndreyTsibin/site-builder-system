---
/**
 * Team2: Featured Lead + Supporting Team
 *
 * Large featured card for lead technician/owner, smaller cards for team.
 * Features: Leadership emphasis, company values, optional stats.
 * Best for: Highlighting business owner and showcasing team strength.
 */

interface Props {
  title: string; // "Познакомьтесь с нашей командой"
  subtitle?: string; // "Опытные специалисты под руководством профессионала"
  lead: {
    photo: string;
    name: string;
    role: string; // "Основатель и главный мастер"
    bio: string; // 2-3 sentences about leadership
    experience: string; // "20 лет опыта"
    certifications?: string[];
  };
  team: Array<{
    photo: string;
    name: string;
    role: string;
    experience: string;
  }>; // 3-6 members
  stats?: Array<{
    value: string; // "12+"
    label: string; // "мастеров в команде"
  }>; // Optional stats
  bgColor?: string; // "white" | "gray-50"
}

const {
  title,
  subtitle,
  lead,
  team,
  stats,
  bgColor = "gray-50"
} = Astro.props;

// Generate unique ID for this instance
const instanceId = Math.random().toString(36).substring(7);
---

<section class={`py-16 md:py-20 lg:py-24 bg-${bgColor}`}>
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    {/* Featured Lead */}
    <div class="mb-16">
      <div class="bg-white rounded-2xl overflow-hidden shadow-2xl max-w-4xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-0">
          {/* Photo */}
          <div class="relative overflow-hidden" style="aspect-ratio: 3/4;">
            <img
              src={lead.photo}
              alt={lead.name}
              class="w-full h-full object-cover"
            />
            {/* Badge */}
            <div class="absolute top-4 left-4">
              <span class="inline-block px-4 py-2 bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-lg">
                {lead.experience}
              </span>
            </div>
          </div>

          {/* Content */}
          <div class="p-8 lg:p-10 flex flex-col justify-center">
            {/* Name */}
            <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 mb-2">
              {lead.name}
            </h3>

            {/* Role */}
            <p class="text-lg text-blue-700 font-semibold mb-6">
              {lead.role}
            </p>

            {/* Bio */}
            <p class="text-base md:text-lg text-gray-600 mb-6">
              {lead.bio}
            </p>

            {/* Certifications */}
            {lead.certifications && lead.certifications.length > 0 && (
              <div>
                <p class="text-sm font-semibold text-gray-700 mb-3">
                  Сертификаты и достижения:
                </p>
                <div class="flex flex-col gap-2">
                  {lead.certifications.map((cert) => (
                    <div class="flex items-center gap-3 text-base text-gray-700">
                      <i class="ri-award-fill text-blue-700 text-xl"></i>
                      <span>{cert}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>

    {/* Stats (Optional) */}
    {stats && stats.length > 0 && (
      <div class="mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          {stats.map((stat) => (
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-blue-700 mb-2">
                {stat.value}
              </div>
              <div class="text-sm md:text-base text-gray-600">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Supporting Team */}
    <div>
      <h3 class="text-2xl md:text-3xl font-bold text-gray-900 text-center mb-8">
        Наша команда
      </h3>
      <div id={`team-grid-${instanceId}`} class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {team.map((member, index) => (
          <div class={`team-member-card-${instanceId} bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 group ${index > 0 ? 'hidden md:block' : ''}`}>
            {/* Photo */}
            <div class="relative overflow-hidden" style="aspect-ratio: 3/4;">
              <img
                src={member.photo}
                alt={member.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              {/* Experience Badge */}
              <div class="absolute top-4 left-4">
                <span class="inline-block px-3 py-1 bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-lg">
                  {member.experience}
                </span>
              </div>
            </div>

            {/* Content */}
            <div class="p-4">
              {/* Name */}
              <h4 class="text-lg font-bold text-gray-900 mb-1">
                {member.name}
              </h4>

              {/* Role */}
              <p class="text-sm text-blue-700 font-semibold">
                {member.role}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/* Show All Button (mobile only) */}
      <div class="mt-6 text-center md:hidden">
        <button
          id={`show-all-btn-${instanceId}`}
          class="px-6 py-3 bg-blue-700 text-white font-semibold rounded-lg hover:bg-blue-800 transition-colors"
        >
          Показать всех мастеров
        </button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ instanceId }}>
  // Show all team members on mobile
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById(`show-all-btn-${instanceId}`);

    if (button) {
      button.addEventListener('click', () => {
        // Show all hidden team member cards
        const cards = document.querySelectorAll(`.team-member-card-${instanceId}`);
        cards.forEach(card => {
          card.classList.remove('hidden');
        });

        // Hide the button
        button.parentElement.style.display = 'none';
      });
    }
  });
</script>
