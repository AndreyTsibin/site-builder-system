---
/**
 * Testimonials3 — Customer Reviews Carousel with Work Photos
 *
 * Swiper.js carousel with customer testimonials and photos of completed work.
 * Each card: left side = work photo, right side = testimonial (avatar, stars, name, date, text).
 * Shows 1 testimonial per slide (full width card with image).
 */

interface Testimonial {
  name: string;
  date: string;
  rating: number; // 1-5
  text: string;
  avatar?: string;
  workPhoto?: string; // Photo of completed work
}

interface Props {
  heading: string;
  subheading?: string;
  testimonials: Testimonial[];
}

const { heading, subheading, testimonials } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- Swiper Carousel -->
    <div class="relative">
      <div class="swiper testimonials3-swiper">
        <div class="swiper-wrapper">
          {testimonials.map((testimonial) => (
            <div class="swiper-slide h-auto">
              <!-- Testimonial Card with Photo -->
              <div class="bg-white rounded-2xl border-2 border-gray-200 overflow-hidden h-full grid lg:grid-cols-2 gap-0">

                <!-- Left: Work Photo -->
                <div class="h-64 lg:h-auto">
                  <img
                    src={testimonial.workPhoto || '/images/placeholder-img.jpg'}
                    alt={`Работа для ${testimonial.name}`}
                    class="w-full h-full object-cover"
                  />
                </div>

                <!-- Right: Testimonial Content -->
                <div class="p-6 md:p-8 flex flex-col">
                  <!-- Top: Avatar + Stars/Name/Date -->
                  <div class="flex gap-4 mb-4">
                    <!-- Avatar -->
                    <div class="flex-shrink-0">
                      <img
                        src={testimonial.avatar || '/images/placeholder-img.jpg'}
                        alt={testimonial.name}
                        class="w-16 h-16 rounded-full object-cover bg-gray-200"
                      />
                    </div>

                    <!-- Info Block -->
                    <div class="flex-1">
                      <!-- Stars -->
                      <div class="flex gap-1 mb-2">
                        {Array.from({ length: 5 }, (_, i) => (
                          <i
                            class={`${
                              i < testimonial.rating
                                ? 'ri-star-fill text-yellow-400'
                                : 'ri-star-line text-gray-300'
                            } text-lg`}
                          ></i>
                        ))}
                      </div>

                      <!-- Name -->
                      <div class="font-bold text-lg text-gray-900">
                        {testimonial.name}
                      </div>

                      <!-- Date -->
                      <div class="text-sm text-gray-500">
                        {testimonial.date}
                      </div>
                    </div>
                  </div>

                  <!-- Review Text -->
                  <p class="text-gray-700 text-base md:text-lg leading-relaxed">
                    {testimonial.text}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation: Centered arrows + pagination -->
      <div class="mt-8">
        <div class="flex items-center justify-center gap-6 max-w-max mx-auto">
          <button class="swiper-button-prev-custom3 testimonial-nav-button3">
            <i class="ri-arrow-left-s-line"></i>
          </button>

          <div class="swiper-pagination-custom3"></div>

          <button class="swiper-button-next-custom3 testimonial-nav-button3">
            <i class="ri-arrow-right-s-line"></i>
          </button>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Swiper custom styles */
  .testimonials3-swiper {
    padding-bottom: 0;
  }

  .testimonials3-swiper :global(.swiper-wrapper) {
    align-items: stretch;
  }

  .testimonials3-swiper :global(.swiper-slide) {
    height: auto;
    display: flex;
  }

  /* Hide default Swiper navigation */
  .testimonials3-swiper :global(.swiper-button-prev),
  .testimonials3-swiper :global(.swiper-button-next) {
    display: none;
  }

  /* Custom navigation buttons */
  .testimonial-nav-button3 {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e40af; /* blue-700 */
    color: white;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    font-size: 24px;
    flex-shrink: 0;
  }

  .testimonial-nav-button3:hover:not(:disabled) {
    background: #1e3a8a; /* blue-800 */
    transform: scale(1.1);
  }

  .testimonial-nav-button3:disabled {
    background: #d1d5db; /* gray-300 */
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Custom pagination */
  .swiper-pagination-custom3 {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
  }

  .swiper-pagination-custom3 :global(.swiper-pagination-bullet) {
    width: 10px;
    height: 10px;
    background: #9ca3af; /* gray-400 */
    opacity: 1;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .swiper-pagination-custom3 :global(.swiper-pagination-bullet-active) {
    background: #1e40af; /* blue-700 */
    width: 32px;
    border-radius: 5px;
  }
</style>

<script>
  // Initialize Swiper
  import Swiper from 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs';

  const swiper = new Swiper('.testimonials3-swiper', {
    slidesPerView: 1,
    spaceBetween: 32,
    loop: true,
    navigation: {
      nextEl: '.swiper-button-next-custom3',
      prevEl: '.swiper-button-prev-custom3',
    },
    pagination: {
      el: '.swiper-pagination-custom3',
      clickable: true,
    }
  });
</script>
