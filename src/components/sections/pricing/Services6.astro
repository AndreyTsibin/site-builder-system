---
interface ServiceCard {
  image: string;
  title: string;
  description: string;
  price: string;
}

interface Props {
  title: string;
  subtitle: string;
  services: ServiceCard[];
}

const { title, subtitle, services } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-white">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-gray-600 max-w-4xl">
        {subtitle}
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {services.map((service) => (
        <div class="flex flex-col bg-gray-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-300">
          <!-- Image Header -->
          <div class="relative w-full h-64 bg-gray-100">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-grow">
            <!-- Title -->
            <h3 class="text-xl md:text-2xl font-bold text-blue-700 mb-4">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-gray-700 mb-6 flex-grow">
              {service.description}
            </p>

            <!-- Price Button -->
            <button
              type="button"
              class="w-full py-3.5 px-6 bg-blue-700 hover:bg-blue-800 text-white font-semibold rounded-lg transition-colors duration-200"
            >
              {service.price}
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
