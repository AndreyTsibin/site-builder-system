---
interface PackageItem {
  badge: string;
  badgeColor: string; // Tailwind color classes for badge
  image: string;
  title: string;
  subtitle: string;
  description: string;
  includes: string[];
  features: string[];
  price: string;
  ctaText: string;
}

interface Props {
  title: string;
  subtitle: string;
  packages: PackageItem[];
}

const { title, subtitle, packages } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-white">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-gray-600 max-w-4xl">
        {subtitle}
      </p>
    </div>

    <!-- Packages Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {packages.map((pkg) => (
        <div class="relative flex flex-col bg-gray-50 border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-300">
          <!-- Image Header -->
          <div class="relative w-full h-64 bg-gray-100">
            <img
              src={pkg.image}
              alt={pkg.title}
              class="w-full h-full object-cover"
            />
            <!-- Badge on top of image -->
            <div class={`absolute top-4 left-4 px-4 py-1.5 rounded-full text-xs font-semibold text-white ${pkg.badgeColor}`}>
              {pkg.badge}
            </div>
          </div>

          <!-- Block 1: Title + Description -->
          <div class="bg-gray-50 p-6">
            <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
              {pkg.title}
            </h3>
            <p class="text-sm font-medium text-gray-700 mb-2">
              {pkg.subtitle}
            </p>
            <p class="text-sm text-gray-600">
              {pkg.description}
            </p>
          </div>

          <!-- Block 2: Includes Section -->
          <div class="bg-white p-6">
            <h4 class="text-sm font-semibold text-gray-900 mb-3">Что входит:</h4>
            <ul class="space-y-2">
              {pkg.includes.map((item) => (
                <li class="text-sm text-gray-700 flex items-start gap-2">
                  <span class="text-gray-400 mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Block 3: Features Section -->
          <div class="bg-gray-50 p-6">
            <h4 class="text-sm font-semibold text-gray-900 mb-3">Технические характеристики:</h4>
            <ul class="space-y-2">
              {pkg.features.map((feature) => (
                <li class="text-sm text-gray-700 flex items-start gap-2">
                  <i class="ri-checkbox-circle-line text-green-600 text-base mt-0.5 flex-shrink-0"></i>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Block 4: Price + CTA (pushed to bottom) -->
          <div class="mt-auto bg-gray-50 p-6 space-y-4">
            <p class="text-3xl md:text-4xl font-bold text-blue-700">
              {pkg.price}
            </p>
            <button
              type="button"
              class="w-full py-3.5 px-6 bg-blue-700 hover:bg-blue-800 text-white font-semibold rounded-lg transition-colors duration-200"
            >
              {pkg.ctaText}
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
