---
/**
 * Hero5 — Hero with Badge, Benefits & CTA
 *
 * Two-column hero section: left has badge, heading, benefits, CTA; right has image
 * Perfect for service providers highlighting experience and key benefits
 *
 * Usage:
 * <Hero5
 *   badge="Опыт 12 лет"
 *   badgeLink="#about"
 *   badgeLinkText="Узнать больше >"
 *   title="Ремонт стиральных машин любой сложности"
 *   subtitle="Мастер-специалист Сергей Иванов"
 *   benefits={[
 *     "Гарантия до 2 лет на все виды работ",
 *     "Выезд и диагностика бесплатно",
 *     "Оригинальные запчасти в наличии"
 *   ]}
 *   ctaText="Бесплатная консультация"
 *   ctaUrl="#contact"
 *   imageUrl="/images/placeholder-img.jpg"
 *   imageAlt="Ремонт стиральных машин"
 * />
 */

interface Props {
  badge: string;
  badgeLink?: string;
  badgeLinkText?: string;
  title: string;
  subtitle: string;
  benefits: string[];
  ctaText: string;
  ctaUrl: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  badge,
  badgeLink = "#",
  badgeLinkText = "Узнать больше >",
  title,
  subtitle,
  benefits,
  ctaText,
  ctaUrl,
  imageUrl = "/images/placeholder-img.jpg",
  imageAlt = "Hero image"
} = Astro.props;
---

<section class="bg-white py-16 md:py-20 lg:py-24">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left Column: Content -->
      <div class="space-y-6">
        <!-- Badge & Link -->
        <div class="flex items-center gap-4 flex-wrap">
          <span class="inline-block px-6 py-2 text-sm font-medium text-white bg-blue-600 rounded-full">
            {badge}
          </span>
          <a
            href={badgeLink}
            class="text-sm font-medium text-gray-900 hover:text-gray-700 transition-colors"
          >
            {badgeLinkText}
          </a>
        </div>

        <!-- Heading -->
        <h1 class="max-w-2xl text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight leading-tight">
          {title}
        </h1>

        <!-- Subtitle -->
        <p class="max-w-2xl text-base md:text-lg text-gray-500">
          {subtitle}
        </p>

        <!-- Benefits List -->
        <ul class="space-y-3">
          {benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <i class="ri-checkbox-circle-fill text-xl text-green-600 mt-0.5"></i>
              <span class="text-base md:text-lg text-gray-900">{benefit}</span>
            </li>
          ))}
        </ul>

        <!-- CTA Button -->
        <div class="pt-2">
          <a
            href={ctaUrl}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg focus:ring-4 focus:ring-blue-300 transition-colors"
          >
            {ctaText}
          </a>
        </div>
      </div>

      <!-- Right Column: Image -->
      <div class="hidden lg:flex justify-center">
        <img
          src={imageUrl}
          alt={imageAlt}
          class="max-w-full h-auto rounded-xl"
        />
      </div>

    </div>
  </div>
</section>
