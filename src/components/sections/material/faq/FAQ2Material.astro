---
/**
 * FAQ2Material — Material Design FAQ with Elevated Accordions
 *
 * Enhancements over FAQ2:
 * - Gradient accordion items (light source from top)
 * - Elevated items with shadows
 * - Enhanced hover/open states
 * - Image with elevation shadow
 */

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  subheading?: string;
  faqs: FAQItem[];
  image?: string;
  imageAlt?: string;
}

const { heading, subheading, faqs, image = '/images/placeholder-img.jpg', imageAlt = 'FAQ illustration' } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Content + FAQ -->
      <div>
        <!-- Heading -->
        <div class="mb-8 lg:mb-12">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent mb-4">
            {heading}
          </h2>
          {subheading && (
            <p class="text-lg md:text-xl text-gray-600">
              {subheading}
            </p>
          )}
        </div>

        <!-- FAQ Accordion with Material Design -->
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-gradient-to-b from-white to-gray-50 rounded-lg shadow-sm hover:shadow-md transition-all border border-gray-100" name="faq-accordion-2">
              <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-lg text-gray-900 list-none">
                <span>{faq.question}</span>
                <i class="ri-arrow-down-s-line text-2xl text-blue-700 transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="px-6 pb-6 pt-2 text-base md:text-lg text-gray-600 border-t border-gray-200">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Right Column: Image with Elevation (hidden on mobile, shown on lg+) -->
      <div class="hidden lg:block lg:sticky lg:top-8">
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-auto rounded-xl object-cover shadow-lg"
        />
      </div>
    </div>

    <!-- Image below on mobile (visible only on mobile) -->
    <div class="mt-8 lg:hidden">
      <img
        src={image}
        alt={imageAlt}
        class="w-full h-auto rounded-xl shadow-lg object-cover"
      />
    </div>
  </div>
</section>

<script>
  // Close other accordions when one is opened (one open at a time)
  document.addEventListener('DOMContentLoaded', () => {
    const details = document.querySelectorAll('details[name="faq-accordion-2"]');

    details.forEach((targetDetail) => {
      targetDetail.addEventListener('click', () => {
        details.forEach((detail) => {
          if (detail !== targetDetail) {
            detail.removeAttribute('open');
          }
        });
      });
    });
  });
</script>
