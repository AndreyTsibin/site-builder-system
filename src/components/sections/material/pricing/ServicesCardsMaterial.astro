---
/**
 * ServicesCardsMaterial — Premium Services Section with Issue Cards
 *
 * Premium Enhancements (2025 trends):
 * - 🎨 Vertical cards with large image on top
 * - 🌈 Gradient mesh background (lighter than Hero)
 * - 💎 Gradient border on hover (blue → purple)
 * - 🎬 Stagger animation (fadeInUp) on load
 * - ✨ Soft glow shadow on hover + lift effect
 * - 🔥 Full card is clickable for better UX
 * - 💫 Gradient price with premium typography
 * - 🚀 Clean, focused design (6 cards max)
 */

interface ServiceCard {
  image: string;
  issue: string;
  price: string;
}

interface Props {
  heading?: string;
  subheading?: string;
  services?: ServiceCard[];
}

const {
  heading = "Ремонт холодильников всех типов",
  subheading = "Выберите неисправность и узнайте стоимость ремонта. Вызовите мастера прямо сейчас!",
  services = [
    { image: "/images/placeholder-img.jpg", issue: "Не морозит", price: "от 1500₽" },
    { image: "/images/placeholder-img.jpg", issue: "Протекает вода", price: "от 1200₽" },
    { image: "/images/placeholder-img.jpg", issue: "Шумит и гудит", price: "от 1000₽" },
    { image: "/images/placeholder-img.jpg", issue: "Не включается", price: "от 1800₽" },
    { image: "/images/placeholder-img.jpg", issue: "Намерзает лёд", price: "от 1300₽" },
    { image: "/images/placeholder-img.jpg", issue: "Не отключается компрессор", price: "от 1400₽" },
  ],
} = Astro.props;
---

<section class="relative py-16 md:py-20 lg:py-24 overflow-hidden">
  <!-- Gradient Mesh Background (lighter than Hero) -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-purple-50/20 to-pink-50/10"></div>
  <div class="absolute inset-0 bg-gradient-to-tl from-cyan-50/30 via-transparent to-indigo-50/20"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(96,165,250,0.05),transparent_50%)]"></div>

  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent">
        {heading}
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        {subheading}
      </p>
    </div>

    <!-- Services Grid with Premium Vertical Cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        services.map((service, index) => (
          <button
            type="button"
            class="service-card group relative bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 text-left w-full opacity-0 border-2 border-transparent hover:border-blue-500/30 flex flex-col h-full"
            style={`animation-delay: ${index * 100}ms`}
          >
            <!-- Large Image on Top with Gradient Overlay (fixed height) -->
            <div class="aspect-[4/3] overflow-hidden bg-gray-100 relative flex-shrink-0">
              <img
                src={service.image}
                alt={service.issue}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <!-- Subtle gradient overlay for depth -->
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/5 pointer-events-none"></div>
            </div>

            <!-- Content Section with Premium Gradient Background (grows to fill space) -->
            <div class="p-6 space-y-4 bg-gradient-to-b from-white to-gray-50/30 flex flex-col flex-grow">
              <!-- Issue Title with Gradient (larger for premium feel) -->
              <h3 class="text-2xl md:text-3xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent group-hover:from-blue-700 group-hover:via-blue-800 group-hover:to-blue-700 transition-all duration-300">
                {service.issue}
              </h3>

              <!-- Price (Premium, no label) -->
              <p class="text-2xl md:text-3xl font-bold text-gray-900">
                {service.price}
              </p>

              <!-- CTA Button (Ghost-to-Solid with Subtle Border) - pushed to bottom -->
              <div class="pt-2 mt-auto">
                <span class="cta-button-card inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-blue-700 bg-white rounded-xl border border-blue-300/40 shadow-sm group-hover:bg-gradient-to-b group-hover:from-blue-600 group-hover:to-blue-700 group-hover:text-white group-hover:border-transparent group-hover:shadow-lg group-hover:shadow-blue-500/30">
                  Вызвать мастера
                  <i class="ri-arrow-right-line text-base group-hover:translate-x-1 transition-transform duration-300"></i>
                </span>
              </div>
            </div>

            <!-- Subtle Glow Effect on Hover -->
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none shadow-[0_0_30px_rgba(59,130,246,0.2)]"></div>
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Fade In Up Animation with Stagger */
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .service-card {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Hover Lift Effect */
  .service-card:hover {
    transform: translateY(-8px);
  }

  /* Active State */
  .service-card:active {
    transform: translateY(-4px) scale(0.98);
  }

  /* Smooth transitions for CTA button (Material Design 3 style) */
  .cta-button-card {
    transition:
      color 400ms cubic-bezier(0.4, 0, 0.2, 1),
      background 400ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 400ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
