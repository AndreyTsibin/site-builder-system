---
/**
 * ServicesCardsMaterial — Premium Minimal Service Cards
 *
 * Premium Enhancements (2025 trends):
 * - 🎨 Ultra-clean minimalist design (icon + name + price only)
 * - 🌈 Gradient mesh background (lighter than Hero)
 * - 💎 Subtle border + shadow on hover
 * - 🎬 Stagger animation (fadeInUp) on load
 * - ✨ Lift effect on hover (-translate-y-2)
 * - 🔥 Full card is clickable (no separate CTA button)
 * - 💫 Large gradient price (3xl → 4xl) as main focus
 * - 🚀 Arrow icon appears on hover (visual hint)
 * - 📐 Compact icon (w-14 h-14) with rounded-2xl
 * - 💨 Lots of white space for premium feel
 */

interface ServiceCard {
  icon: string; // Remix Icon class
  name: string;
  price: string;
  description?: string;
}

interface Props {
  id?: string;
  heading?: string;
  subheading?: string;
  services?: ServiceCard[];
  ctaText?: string;
  ctaUrl?: string;
}

const {
  id,
  heading = "Ремонт холодильников всех типов",
  subheading = "Выберите неисправность и узнайте стоимость ремонта. Вызовите мастера прямо сейчас!",
  services = [
    { icon: "ri-snowflake-line", name: "Не морозит", price: "от 1500₽" },
    { icon: "ri-drop-line", name: "Протекает вода", price: "от 1200₽" },
    { icon: "ri-volume-up-line", name: "Шумит и гудит", price: "от 1000₽" },
    { icon: "ri-plug-line", name: "Не включается", price: "от 1800₽" },
    { icon: "ri-temp-cold-line", name: "Намерзает лёд", price: "от 1300₽" },
    { icon: "ri-settings-3-line", name: "Не отключается компрессор", price: "от 1400₽" },
  ],
  ctaText = "Вызвать мастера",
  ctaUrl = "#lid-form"
} = Astro.props;

// Color themes for icon rotation (Purple → Blue → Green → Orange → Pink → Teal)
const iconThemes = [
  {
    bg: 'from-purple-600 to-purple-700',
    shadow: 'shadow-purple-500/20',
    hoverShadow: 'group-hover:shadow-purple-500/40'
  },
  {
    bg: 'from-blue-600 to-blue-700',
    shadow: 'shadow-blue-500/20',
    hoverShadow: 'group-hover:shadow-blue-500/40'
  },
  {
    bg: 'from-green-600 to-green-700',
    shadow: 'shadow-green-500/20',
    hoverShadow: 'group-hover:shadow-green-500/40'
  },
  {
    bg: 'from-orange-600 to-orange-700',
    shadow: 'shadow-orange-500/20',
    hoverShadow: 'group-hover:shadow-orange-500/40'
  },
  {
    bg: 'from-pink-600 to-pink-700',
    shadow: 'shadow-pink-500/20',
    hoverShadow: 'group-hover:shadow-pink-500/40'
  },
  {
    bg: 'from-teal-600 to-teal-700',
    shadow: 'shadow-teal-500/20',
    hoverShadow: 'group-hover:shadow-teal-500/40'
  }
];
---

<section id={id} class="relative py-16 md:py-20 lg:py-24 overflow-hidden">
  <!-- Gradient Mesh Background (lighter than Hero) -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-purple-50/20 to-pink-50/10"></div>
  <div class="absolute inset-0 bg-gradient-to-tl from-cyan-50/30 via-transparent to-indigo-50/20"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(96,165,250,0.05),transparent_50%)]"></div>

  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent">
        {heading}
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        {subheading}
      </p>
    </div>

    <!-- Services Grid with Premium Minimal Cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        services.map((service, index) => {
          const theme = iconThemes[index % iconThemes.length];
          return (
            <a
              href={ctaUrl}
              class="service-card group relative bg-white rounded-3xl p-8 shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 text-center w-full opacity-0 border border-gray-100 hover:border-blue-200"
              style={`animation-delay: ${index * 100}ms`}
            >
              <!-- Icon - Compact & Colorful -->
              <div class={`w-14 h-14 mx-auto mb-6 flex items-center justify-center bg-gradient-to-br ${theme.bg} rounded-2xl shadow-lg ${theme.shadow} ${theme.hoverShadow} group-hover:scale-110 transition-all duration-300`}>
                <i class={`${service.icon} text-2xl text-white`}></i>
              </div>

              <!-- Service Name - Bold & Clear -->
              <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-6 leading-tight">
                {service.name}
              </h3>

              <!-- Price - Large Gradient with Arrow on Hover -->
              <div class="flex items-center justify-center gap-2">
                <p class="text-3xl md:text-4xl font-black bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 bg-clip-text text-transparent">
                  {service.price}
                </p>
                <i class="ri-arrow-right-line text-2xl text-blue-600 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300"></i>
              </div>

              <!-- Glow Effect on Hover -->
              <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-blue-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Fade In Up Animation with Stagger */
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .service-card {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Active State */
  .service-card:active {
    transform: translateY(-1px) scale(0.98);
  }
</style>
