---
/**
 * Benefits2Material — Material Design Benefits with Elevated Cards
 *
 * Enhancements over Benefits2:
 * - Gradient stat cards (light source from top)
 * - Elevated cards with shadows for depth
 * - Enhanced hover states with scale + shadow
 * - Smooth transitions for premium feel
 */

interface Props {
  title?: string;
  subtitle?: string;
  stats?: Array<{
    number: string;
    label: string;
    description: string;
    icon?: string;
  }>;
}

const {
  title = "Нам доверяют",
  subtitle = "Цифры, которые говорят о качестве нашей работы",
  stats = [
    {
      number: "10+",
      label: "лет на рынке",
      description: "Профессиональный опыт и проверенная репутация",
      icon: "ri-medal-line"
    },
    {
      number: "2000+",
      label: "довольных клиентов",
      description: "Успешно выполненных заказов по ремонту техники",
      icon: "ri-user-heart-line"
    },
    {
      number: "12 мес",
      label: "гарантия",
      description: "На все виды работ и установленные запчасти",
      icon: "ri-shield-check-line"
    },
    {
      number: "30 мин",
      label: "выезд мастера",
      description: "Быстрый отклик и оперативное решение проблемы",
      icon: "ri-time-line"
    }
  ]
} = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4 text-gray-900">{title}</h2>
      <p class="text-lg md:text-xl text-gray-600">{subtitle}</p>
    </div>

    <!-- Stats Grid with Material Design Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {stats.map((stat) => (
        <div class="bg-gradient-to-b from-white to-gray-50 p-8 rounded-2xl shadow-md hover:shadow-xl hover:scale-105 transition-all duration-300 text-center border border-gray-100">
          <!-- Icon (optional) -->
          {stat.icon && (
            <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl shadow-sm">
              <i class={`${stat.icon} text-4xl text-blue-700`}></i>
            </div>
          )}

          <!-- Number -->
          <div class="text-4xl md:text-5xl lg:text-6xl font-bold text-blue-700 mb-2">
            {stat.number}
          </div>

          <!-- Label -->
          <h3 class="text-xl md:text-2xl font-semibold mb-3 text-gray-900">{stat.label}</h3>

          <!-- Description -->
          <p class="text-base text-gray-600">{stat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
