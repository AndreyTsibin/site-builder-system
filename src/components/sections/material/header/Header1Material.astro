---
/**
 * Header1Material — Premium Glassmorphism Header
 *
 * Premium Enhancements (2025 trends):
 * - ✨ Glassmorphism: backdrop-blur-lg + semi-transparent background
 * - 🎨 Enhanced CTA: shimmer animation + glow effect on hover
 * - 🌈 Gradient underline animation for menu links
 * - 📱 Scroll-triggered header shrink animation
 * - 💎 Logo hover glow effect
 * - 🔮 Layered depth with shadows and blur
 * - ⚡ Smooth micro-interactions for all elements
 */

interface Props {
  logo: string;
  logoIcon?: string;
  menuItems?: { label: string; href: string }[];
  phone: string;
  workingHours?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  logo,
  logoIcon = 'ri-tools-line',
  menuItems = [
    { label: 'Услуги', href: '#services' },
    { label: 'Отзывы', href: '#testimonials' },
    { label: 'Контакты', href: '#contacts' }
  ],
  phone,
  workingHours = 'Ежедневно 8:00 - 22:00',
  ctaText = 'Вызвать мастера',
  ctaLink = '#cta'
} = Astro.props;
---

<header class="header-glass fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg backdrop-saturate-150 shadow-lg border-b border-white/20 transition-all duration-300">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="header-content flex items-center justify-between py-3 md:py-4 transition-all duration-300">
      <!-- Premium Logo with Gradient Circle + Gradient Text -->
      <div class="flex-shrink-0">
        <a href="/" class="logo-link flex items-center gap-3 group transition-all duration-300">
          <!-- Icon in Gradient Circle -->
          <div class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center bg-gradient-to-br from-blue-600 via-blue-700 to-purple-600 rounded-full shadow-lg shadow-blue-500/30 group-hover:shadow-xl group-hover:shadow-blue-500/50 transition-all duration-300 group-hover:scale-110 group-hover:rotate-6">
            <i class={`${logoIcon} text-xl md:text-2xl text-white`}></i>
          </div>
          <!-- Gradient Text -->
          <span class="text-xl md:text-2xl font-black bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent group-hover:from-blue-700 group-hover:via-blue-800 group-hover:to-blue-700 transition-all duration-300">{logo}</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8">
        {menuItems.map((item) => (
          <a
            href={item.href}
            class="menu-link-underline text-base text-gray-700 hover:text-blue-700 transition-colors font-medium relative py-1"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop Phone + CTA -->
      <div class="hidden md:flex items-center gap-4">
        <!-- Phone Block -->
        <div class="flex flex-col">
          <a
            href={`tel:${phone.replace(/\s/g, '')}`}
            class="flex items-center gap-2 text-base lg:text-lg font-semibold text-gray-900 hover:text-blue-700 transition-colors"
          >
            <i class="ri-phone-line text-xl"></i>
            <span>{phone}</span>
          </a>
          <span class="text-xs text-gray-600 ml-7">{workingHours}</span>
        </div>
        <!-- Premium CTA Button with Shimmer + Glow -->
        <a
          href={ctaLink}
          class="cta-button relative inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/50 hover:shadow-2xl hover:scale-105 active:scale-100 transition-all duration-300 overflow-hidden group"
        >
          <span class="relative z-10 flex items-center gap-2">
            {ctaText}
            <i class="ri-arrow-right-line text-xl group-hover:translate-x-1 transition-transform duration-300"></i>
          </span>
          <!-- Shimmer overlay -->
          <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent shimmer-animation"></span>
        </a>
      </div>

      <!-- Mobile: Phone + Burger -->
      <div class="flex md:hidden items-center gap-3">
        <a
          href={`tel:${phone.replace(/\s/g, '')}`}
          class="text-blue-700 hover:text-blue-800 transition-colors"
        >
          <i class="ri-phone-line text-2xl"></i>
        </a>
        <button
          id="burger-btn"
          class="text-gray-700 hover:text-blue-700 transition-colors"
          aria-label="Открыть меню"
        >
          <i class="ri-menu-line text-2xl"></i>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Sidebar Menu -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden">
</div>

<aside
  id="mobile-menu"
  class="fixed top-0 right-0 bottom-0 w-4/5 max-w-sm bg-white/90 backdrop-blur-xl backdrop-saturate-150 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 border-l border-white/20"
>
  <div class="flex flex-col h-full">
    <!-- Sidebar Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-200">
      <div class="flex items-center gap-3">
        <!-- Icon in Gradient Circle -->
        <div class="w-10 h-10 flex items-center justify-center bg-gradient-to-br from-blue-600 via-blue-700 to-purple-600 rounded-full shadow-lg shadow-blue-500/30">
          <i class={`${logoIcon} text-xl text-white`}></i>
        </div>
        <!-- Gradient Text -->
        <span class="text-xl font-black bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent">{logo}</span>
      </div>
      <button
        id="close-menu-btn"
        class="text-gray-700 hover:text-red-600 transition-colors"
        aria-label="Закрыть меню"
      >
        <i class="ri-close-line text-2xl"></i>
      </button>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="flex-1 p-6">
      <ul class="space-y-4">
        {menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-menu-link block text-lg font-medium text-gray-700 hover:text-blue-700 transition-colors py-2"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Sidebar Footer -->
    <div class="p-6 border-t border-gray-200 space-y-4">
      <!-- Phone Block -->
      <div class="flex flex-col gap-1">
        <a
          href={`tel:${phone.replace(/\s/g, '')}`}
          class="flex items-center gap-3 text-lg font-semibold text-gray-900 hover:text-blue-700 transition-colors"
        >
          <i class="ri-phone-line text-xl"></i>
          <span>{phone}</span>
        </a>
        <span class="text-xs text-gray-600 ml-9">{workingHours}</span>
      </div>
      <!-- Premium CTA Button with Shimmer + Glow -->
      <a
        href={ctaLink}
        class="cta-button relative inline-flex items-center justify-center w-full px-6 py-3 bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/50 hover:shadow-2xl active:scale-95 transition-all duration-300 overflow-hidden group text-center"
      >
        <span class="relative z-10 flex items-center gap-2">
          {ctaText}
          <i class="ri-arrow-right-line text-xl group-hover:translate-x-1 transition-transform duration-300"></i>
        </span>
        <!-- Shimmer overlay -->
        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent shimmer-animation"></span>
      </a>
    </div>
  </div>
</aside>

<script>
  const burgerBtn = document.getElementById('burger-btn');
  const closeMobileMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');

  function openMenu() {
    mobileMenu?.classList.remove('translate-x-full');
    mobileMenuOverlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.add('translate-x-full');
    mobileMenuOverlay?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  burgerBtn?.addEventListener('click', openMenu);
  closeMobileMenuBtn?.addEventListener('click', closeMenu);
  mobileMenuOverlay?.addEventListener('click', closeMenu);

  // Close menu when clicking on menu links
  mobileMenuLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });

  // Scroll-triggered header behavior (simplified - no hiding)
  const header = document.querySelector('.header-glass');

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;

    // Add/remove scrolled class for styling
    if (currentScroll > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
</script>

<style>
  /* Premium Gradient Underline for Menu Links */
  .menu-link-underline::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #2563eb, #3b82f6, #60a5fa); /* blue gradient */
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease-in-out;
    box-shadow: 0 0 8px rgba(37, 99, 235, 0.5);
  }

  .menu-link-underline:hover::after {
    transform: scaleX(1);
  }

  /* Shimmer Animation for CTA Button */
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .shimmer-animation {
    animation: shimmer 3s infinite;
  }

  /* Pause shimmer on hover for better UX */
  .cta-button:hover .shimmer-animation {
    animation-play-state: paused;
  }

  /* Scroll-triggered Header Shrink */
  .header-glass.scrolled {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .header-glass.scrolled .header-content {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
</style>

<!-- Spacer to prevent content from hiding under fixed header -->
<div class="h-[60px] md:h-[72px]"></div>
