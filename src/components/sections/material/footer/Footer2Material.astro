---
/**
 * Footer2Material — Premium Material Design 3 Footer
 *
 * Premium Enhancements (2025 trends):
 * - 🎨 H3 gradient headings for column titles
 * - 💫 Gradient logo text
 * - 💎 Premium ring effect on social icons
 * - 🔥 Enhanced CTA with shimmer animation
 * - ✨ Premium hover states with colored shadows
 * - 🚀 Material Design 3 elevation system
 */

interface Props {
  logo: string;
  logoIcon?: string;
  description?: string;
  phone: string;
  workingHours?: string;
  email: string;
  address: string;
  socialLinks?: {
    vk?: string;
    telegram?: string;
    whatsapp?: string;
  };
  menuItems?: { label: string; href: string }[];
  ctaText?: string;
  ctaHref?: string;
  copyrightText?: string;
  companyDetails?: {
    legalForm?: string;
    inn?: string;
    ogrn?: string;
  };
  mapUrl?: string;
}

const {
  logo = 'Ремонт Техники',
  logoIcon = 'ri-tools-line',
  description = 'Профессиональный ремонт бытовой техники с гарантией качества. Опыт более 10 лет.',
  phone = '+7 (495) 123-45-67',
  workingHours = 'Ежедневно 9:00 - 21:00',
  email = 'info@remont-service.ru',
  address = 'г. Москва, ул. Примерная, д. 10',
  socialLinks = {
    vk: 'https://vk.com/',
    telegram: 'https://t.me/',
    whatsapp: 'https://wa.me/'
  },
  menuItems = [
    { label: 'Главная', href: '#home' },
    { label: 'Услуги', href: '#services' },
    { label: 'Цены', href: '#pricing' },
    { label: 'О компании', href: '#about' },
    { label: 'Отзывы', href: '#testimonials' },
    { label: 'Контакты', href: '#contacts' }
  ],
  ctaText = 'Вызвать мастера',
  ctaHref = '#contact',
  copyrightText = 'Все права защищены',
  companyDetails = {
    legalForm: 'ИП Иванов Иван Иванович',
    inn: '773456789012',
    ogrn: '123456789012345'
  },
  mapUrl = 'https://yandex.ru/map-widget/v1/?um=constructor%3A...'
} = Astro.props;
---

<footer class="bg-gray-900 text-gray-300">
  <!-- Main Footer Content -->
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12">

      <!-- Column 1: Logo + Description + Navigation -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <!-- Icon in Gradient Circle -->
          <div class="w-10 h-10 flex items-center justify-center bg-gradient-to-br from-blue-600 via-blue-700 to-purple-600 rounded-full shadow-lg shadow-blue-500/30">
            <i class={`${logoIcon} text-xl text-white`}></i>
          </div>
          <!-- Gradient Logo Text -->
          <span class="text-xl md:text-2xl font-black bg-gradient-to-r from-white via-blue-200 to-white bg-clip-text text-transparent">{logo}</span>
        </div>
        {description && (
          <p class="text-sm text-gray-400 leading-relaxed">
            {description}
          </p>
        )}
      </div>

      <!-- Column 2: Contacts + CTA -->
      <div class="space-y-6">
        <h3 class="text-base md:text-lg font-bold bg-gradient-to-r from-white via-blue-200 to-white bg-clip-text text-transparent">Контакты</h3>

        <div class="space-y-3">
          <!-- Phone -->
          <a href={`tel:${phone.replace(/[^\d+]/g, '')}`} class="flex items-center gap-3 group">
            <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full bg-gradient-to-br from-blue-600 via-blue-700 to-purple-600 shadow-lg shadow-blue-500/20 ring-2 ring-blue-700/50 group-hover:scale-110 group-hover:shadow-blue-500/40 transition-all duration-300">
              <i class="ri-phone-line text-sm text-white"></i>
            </div>
            <div>
              <div class="text-sm font-semibold text-white group-hover:text-blue-300 transition-colors">{phone}</div>
              {workingHours && <div class="text-xs text-gray-500">{workingHours}</div>}
            </div>
          </a>

          <!-- Address -->
          <div class="flex items-center gap-3 text-sm">
            <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full bg-gradient-to-br from-blue-600 via-blue-700 to-purple-600 shadow-lg shadow-blue-500/20 ring-2 ring-blue-700/50">
              <i class="ri-map-pin-line text-sm text-white"></i>
            </div>
            <span class="text-gray-300">{address}</span>
          </div>
        </div>

        <!-- Premium CTA Button with Shimmer -->
        {ctaText && ctaHref && (
          <div>
            <a
              href={ctaHref}
              class="footer-cta relative inline-flex items-center justify-center w-full px-6 py-3 bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/50 hover:shadow-2xl hover:scale-105 active:scale-100 transition-all duration-300 text-sm overflow-hidden group"
            >
              <span class="relative z-10 flex items-center gap-2">
                {ctaText}
                <i class="ri-arrow-right-line text-lg group-hover:translate-x-1 transition-transform duration-300"></i>
              </span>
              <!-- Shimmer overlay -->
              <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent shimmer-animation"></span>
            </a>
          </div>
        )}
      </div>

      <!-- Column 3: Yandex Map -->
      <div class="lg:col-span-2">
        <h3 class="text-base md:text-lg font-bold bg-gradient-to-r from-white via-blue-200 to-white bg-clip-text text-transparent mb-4">Как нас найти</h3>
        {mapUrl && (
          <div class="rounded-2xl overflow-hidden shadow-2xl ring-1 ring-gray-700/50 h-64 lg:h-80">
            <iframe
              src={mapUrl}
              width="100%"
              height="100%"
              frameborder="0"
              class="w-full h-full"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Bottom Section: Copyright -->
  <div class="border-t border-gray-800">
    <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <div class="flex flex-col items-center md:items-start gap-2">
          <p>{copyrightText}</p>
          {companyDetails && (
            <!--noindex-->
            <div class="text-xs text-gray-600 flex flex-col md:flex-row md:gap-3">
              {companyDetails.legalForm && <p>{companyDetails.legalForm}</p>}
              {companyDetails.inn && <p>ИНН: {companyDetails.inn}</p>}
              {companyDetails.ogrn && <p>ОГРН: {companyDetails.ogrn}</p>}
            </div>
            <!--/noindex-->
          )}
        </div>
        <div class="flex flex-wrap justify-center gap-4 md:gap-6">
          <a href="#privacy" class="hover:text-gray-300 transition-colors">Политика конфиденциальности</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Shimmer Animation for Premium CTA Button */
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .shimmer-animation {
    animation: shimmer 3s infinite;
  }

  /* Pause shimmer on hover for better UX */
  .footer-cta:hover .shimmer-animation {
    animation-play-state: paused;
  }
</style>
