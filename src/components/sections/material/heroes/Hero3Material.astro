---
/**
 * Hero3Material — Premium Hero Section with Wow-Effects
 *
 * Premium Enhancements (2025 trends):
 * - 🌈 Gradient mesh background with layered depth
 * - 🎨 Bold gradient typography (text-5xl → md:text-6xl → xl:text-7xl)
 * - 📸 Professional static hero image (no animation for credibility)
 * - 🎯 Compact Horizontal Benefits (icon left + text right) with color rotation (Purple → Blue → Green → Orange)
 * - 💫 Independent floating animation for each benefit icon (stagger delay)
 * - 🎬 Bounce-in animation with stagger effect
 * - 🔥 Enhanced shimmer CTA with glow on hover (main focal point)
 * - 🔮 Micro-interactions: icon scale + rotate on hover, colored shadows
 * - 🚀 Premium visual hierarchy: CTA > Content > Benefits
 */

interface Benefit {
  icon: string;
  text: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  benefits: Benefit[];
  ctaText: string;
  ctaHref?: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  description,
  benefits,
  ctaText,
  ctaHref = "#contact",
  imageUrl = "/images/placeholder-img.jpg",
  imageAlt = "Hero image"
} = Astro.props;
---

<section class="relative pt-16 md:pt-20 lg:pt-24 pb-16 md:pb-20 lg:pb-24 overflow-hidden">
  <!-- Gradient Mesh Background with Layered Depth -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-purple-50/30 to-pink-50/20"></div>
  <div class="absolute inset-0 bg-gradient-to-tl from-cyan-50/40 via-transparent to-indigo-50/30"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(96,165,250,0.1),transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_60%,rgba(167,139,250,0.08),transparent_50%)]"></div>
  <!-- Bottom Fade to Gray (smooth transition to next section) -->
  <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent via-gray-100/90 to-gray-50"></div>
  <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-gray-100 to-transparent"></div>

  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left Column: Content + Benefits + CTA -->
      <div class="space-y-6">
        <!-- Bold Gradient Heading -->
        <h1 class="max-w-2xl">
          <span class="block text-4xl sm:text-5xl md:text-6xl xl:text-6xl font-black tracking-tight leading-tight bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent break-words">
            {title}
          </span>
          <span class="block mt-2 text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold tracking-tight leading-tight bg-gradient-to-r from-blue-700 via-blue-600 to-blue-700 bg-clip-text text-transparent break-words">
            {subtitle}
          </span>
        </h1>

        <!-- Description -->
        <p class="max-w-2xl text-lg md:text-xl font-light text-gray-700" set:html={description} />

        <!-- Compact Horizontal Benefits - Icon Left + Text Right -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
          {benefits.map((benefit, index) => {
            const colorThemes = [
              { iconBg: 'from-purple-100 to-purple-200', iconColor: 'text-purple-600', shadow: 'shadow-purple-500/20', hoverShadow: 'group-hover:shadow-purple-500/40' },
              { iconBg: 'from-blue-100 to-blue-200', iconColor: 'text-blue-600', shadow: 'shadow-blue-500/20', hoverShadow: 'group-hover:shadow-blue-500/40' },
              { iconBg: 'from-green-100 to-green-200', iconColor: 'text-green-600', shadow: 'shadow-green-500/20', hoverShadow: 'group-hover:shadow-green-500/40' },
              { iconBg: 'from-orange-100 to-orange-200', iconColor: 'text-orange-600', shadow: 'shadow-orange-500/20', hoverShadow: 'group-hover:shadow-orange-500/40' }
            ];
            const theme = colorThemes[index % colorThemes.length];
            return (
              <div
                class="benefit-item floating-icon opacity-0 group flex items-center gap-3"
                style={`animation-delay: ${index * 100}ms; --float-delay: ${index * 0.4}s`}
              >
                <!-- Compact Icon -->
                <div class={`w-12 h-12 flex-shrink-0 flex items-center justify-center bg-gradient-to-br ${theme.iconBg} rounded-full shadow-lg ${theme.shadow} group-hover:shadow-xl ${theme.hoverShadow} transition-all duration-300 group-hover:scale-110 group-hover:rotate-6`}>
                  <i class={`${benefit.icon} text-xl ${theme.iconColor}`}></i>
                </div>
                <!-- Text Right -->
                <span class="text-sm md:text-base font-medium text-gray-900 leading-tight">{benefit.text}</span>
              </div>
            );
          })}
        </div>

        <!-- Enhanced Premium CTA Button with Shimmer + Glow -->
        <div class="pt-6">
          <a
            href={ctaHref}
            class="hero-cta-button w-full sm:w-auto inline-flex items-center justify-center px-12 py-5 text-xl font-bold text-white bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 rounded-2xl shadow-xl hover:shadow-blue-500/50 hover:shadow-2xl hover:scale-105 active:scale-100 transition-all duration-300 relative overflow-hidden group"
          >
            <span class="relative z-10 flex items-center gap-2">
              {ctaText}
              <i class="ri-arrow-right-line text-2xl group-hover:translate-x-1 transition-transform duration-300"></i>
            </span>
            <!-- Enhanced Shimmer overlay -->
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent shimmer-animation"></span>
          </a>
        </div>
      </div>

      <!-- Right Column: Professional Static Image -->
      <div class="hidden lg:flex justify-center items-center">
        <div>
          <img
            src={imageUrl}
            alt={imageAlt}
            class="max-w-full h-auto rounded-2xl shadow-2xl hover:shadow-blue-500/30 transition-shadow duration-500"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Shimmer Animation for Premium CTA Button */
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .shimmer-animation {
    animation: shimmer 3s infinite;
  }

  /* Pause shimmer on hover for better UX */
  .hero-cta-button:hover .shimmer-animation {
    animation-play-state: paused;
  }

  /* Floating Animation for Hero Image */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-10px) rotate(1deg);
    }
    50% {
      transform: translateY(-20px) rotate(-1deg);
    }
    75% {
      transform: translateY(-10px) rotate(1deg);
    }
  }

  .floating-image {
    animation: float 6s ease-in-out infinite;
  }

  /* Floating Icons Animation */
  @keyframes floatIcon {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .floating-icon {
    animation: floatIcon 3s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }

  /* Benefit Icons Fade-In with Bounce */
  @keyframes fadeInBounce {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.8);
    }
    60% {
      opacity: 1;
      transform: translateY(-5px) scale(1.05);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .benefit-item {
    animation: fadeInBounce 0.6s ease-out forwards;
  }
</style>
