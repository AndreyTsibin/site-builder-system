---
/**
 * Hero3Material — Material Design Hero with Depth
 *
 * Enhancements over Hero3:
 * - Gradient background (light source from top)
 * - Unified heading (single color, single size)
 * - Premium CTA button with shimmer animation
 * - Enhanced hover/active states
 * - Image with elevation shadow
 */

interface Benefit {
  icon: string;
  text: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  benefits: Benefit[];
  ctaText: string;
  ctaHref?: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  description,
  benefits,
  ctaText,
  ctaHref = "#contact",
  imageUrl = "/images/placeholder-img.jpg",
  imageAlt = "Hero image"
} = Astro.props;
---

<section class="bg-gradient-to-b from-gray-50 to-white py-16 md:py-20 lg:py-24">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left Column: Content + Benefits + CTA -->
      <div class="space-y-6">
        <!-- Unified Heading -->
        <h1 class="max-w-2xl text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight leading-tight text-gray-900">
          {title}
          <br />
          <span class="block mt-2">{subtitle}</span>
        </h1>

        <!-- Description -->
        <p class="max-w-2xl text-lg md:text-xl font-light text-gray-700" set:html={description} />

        <!-- Benefits List with Gradient Background Cards -->
        <ul class="space-y-3">
          {benefits.map((benefit) => (
            <li class="flex items-center gap-3 bg-gradient-to-r from-green-50 to-emerald-50 p-3 rounded-lg shadow-sm">
              <div class="w-10 h-10 flex items-center justify-center bg-gradient-to-br from-green-100 to-emerald-200 rounded-full shadow-sm flex-shrink-0">
                <i class={`${benefit.icon} text-xl text-green-700`}></i>
              </div>
              <span class="text-base md:text-lg text-gray-900">{benefit.text}</span>
            </li>
          ))}
        </ul>

        <!-- Premium CTA Button with Shimmer Animation -->
        <div class="pt-4">
          <a
            href={ctaHref}
            class="hero-cta-button inline-flex items-center justify-center px-10 py-4 text-lg font-semibold text-white bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 rounded-xl shadow-lg hover:shadow-xl active:shadow-md transition-all duration-300 relative overflow-hidden group"
          >
            <span class="relative z-10">{ctaText}</span>
            <!-- Shimmer overlay -->
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent shimmer-animation"></span>
          </a>
        </div>
      </div>

      <!-- Right Column: Image with Elevation -->
      <div class="hidden lg:flex justify-center">
        <img
          src={imageUrl}
          alt={imageAlt}
          class="max-w-full h-auto rounded-xl shadow-lg"
        />
      </div>

    </div>
  </div>
</section>

<style>
  /* Shimmer Animation for Premium CTA Button */
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .shimmer-animation {
    animation: shimmer 3s infinite;
  }

  /* Pause shimmer on hover for better UX */
  .hero-cta-button:hover .shimmer-animation {
    animation-play-state: paused;
  }

  /* Enhanced hover glow effect */
  .hero-cta-button:hover {
    transform: translateY(-2px);
  }

  .hero-cta-button:active {
    transform: translateY(0);
  }
</style>
