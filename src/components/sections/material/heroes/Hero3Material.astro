---
/**
 * Hero3Material — Material Design Hero with Depth
 *
 * Enhancements over Hero3:
 * - Gradient background (light source from top)
 * - Elevated form inputs with subtle shadows
 * - Material Design button with gradient + depth
 * - Enhanced hover/active states
 * - Image with elevation shadow
 */

interface Benefit {
  icon: string;
  text: string;
}

interface Props {
  title: string;
  titleHighlight: string;
  subtitle: string;
  description: string;
  benefits: Benefit[];
  phonePlaceholder?: string;
  submitText: string;
  privacyText: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title,
  titleHighlight,
  subtitle,
  description,
  benefits,
  phonePlaceholder = "+7 (000) 000-00-00",
  submitText,
  privacyText,
  imageUrl = "/images/placeholder-img.jpg",
  imageAlt = "Hero image"
} = Astro.props;

// Split title to highlight specific part
const titleParts = title.split(titleHighlight);
---

<section class="bg-gradient-to-b from-gray-50 to-white py-16 md:py-20 lg:py-24">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left Column: Content + Benefits + Form -->
      <div class="space-y-6">
        <!-- Heading with highlight -->
        <h1 class="max-w-2xl text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight leading-tight">
          {titleParts[0]}<span class="text-red-600">{titleHighlight}</span>{titleParts[1]}
          <br />
          <span class="block text-3xl md:text-4xl xl:text-5xl mt-2">{subtitle}</span>
        </h1>

        <!-- Description with embedded link/tooltip -->
        <p class="max-w-2xl text-base md:text-lg font-light text-gray-700" set:html={description} />

        <!-- Benefits List with Gradient Background Cards -->
        <ul class="space-y-3">
          {benefits.map((benefit) => (
            <li class="flex items-center gap-3 bg-gradient-to-r from-green-50 to-emerald-50 p-3 rounded-lg shadow-sm">
              <div class="w-10 h-10 flex items-center justify-center bg-gradient-to-br from-green-100 to-emerald-200 rounded-full shadow-sm flex-shrink-0">
                <i class={`${benefit.icon} text-xl text-green-700`}></i>
              </div>
              <span class="text-base md:text-lg text-gray-900">{benefit.text}</span>
            </li>
          ))}
        </ul>

        <!-- Contact Form with Material Design -->
        <div class="pt-4">
          <form class="space-y-4 max-w-md">
            <!-- Phone Input with Elevation -->
            <input
              type="tel"
              placeholder={phonePlaceholder}
              class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg bg-gradient-to-b from-white to-gray-50 shadow-sm focus:ring-2 focus:ring-blue-700 focus:border-blue-700 focus:shadow-md transition-all duration-200"
              pattern="[+]?[0-9\s\-\(\)]+"
              required
            />

            <!-- Submit Button with Material Design Gradient -->
            <button
              type="submit"
              class="w-full px-6 py-3 text-base font-medium text-white bg-gradient-to-b from-blue-600 to-blue-800 rounded-xl shadow-md hover:shadow-lg hover:from-blue-700 hover:to-blue-900 active:from-blue-800 active:to-blue-950 active:shadow-sm focus:ring-4 focus:ring-blue-300 transition-all duration-200"
            >
              {submitText}
            </button>

            <!-- Privacy Policy Text -->
            <p class="text-xs text-gray-500 leading-relaxed" set:html={privacyText} />
          </form>
        </div>
      </div>

      <!-- Right Column: Image with Elevation -->
      <div class="hidden lg:flex justify-center">
        <img
          src={imageUrl}
          alt={imageAlt}
          class="max-w-full h-auto rounded-xl shadow-lg"
        />
      </div>

    </div>
  </div>
</section>
