---
/**
 * Hero3Material — Premium Hero Section with Wow-Effects
 *
 * Premium Enhancements (2025 trends):
 * - 🌈 Gradient mesh background with layered depth
 * - 🎨 Bold gradient typography (text-5xl → md:text-6xl → xl:text-7xl)
 * - ✨ Floating animation for hero image (3D effect)
 * - 🎬 Animated benefits cards with stagger effect
 * - 💫 Enhanced shimmer CTA with glow on hover
 * - 📱 Scroll indicator with animated arrow
 * - 🔮 Micro-interactions for all interactive elements
 * - 🚀 Premium visual hierarchy with increased contrast
 */

interface Benefit {
  icon: string;
  text: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  benefits: Benefit[];
  ctaText: string;
  ctaHref?: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  description,
  benefits,
  ctaText,
  ctaHref = "#contact",
  imageUrl = "/images/placeholder-img.jpg",
  imageAlt = "Hero image"
} = Astro.props;
---

<section class="relative min-h-[90vh] py-16 md:py-20 lg:py-24 overflow-hidden">
  <!-- Gradient Mesh Background with Layered Depth -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-purple-50/30 to-pink-50/20"></div>
  <div class="absolute inset-0 bg-gradient-to-tl from-cyan-50/40 via-transparent to-indigo-50/30"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(96,165,250,0.1),transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_60%,rgba(167,139,250,0.08),transparent_50%)]"></div>

  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left Column: Content + Benefits + CTA -->
      <div class="space-y-6">
        <!-- Bold Gradient Heading -->
        <h1 class="max-w-2xl text-5xl md:text-6xl xl:text-7xl font-black tracking-tight leading-tight">
          <span class="block bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent">
            {title}
          </span>
          <span class="block mt-2 bg-gradient-to-r from-blue-700 via-blue-600 to-blue-700 bg-clip-text text-transparent">
            {subtitle}
          </span>
        </h1>

        <!-- Description -->
        <p class="max-w-2xl text-lg md:text-xl font-light text-gray-700" set:html={description} />

        <!-- Animated Benefits List with Gradient Cards -->
        <ul class="space-y-3">
          {benefits.map((benefit, index) => (
            <li
              class="benefit-card opacity-0 flex items-center gap-3 bg-gradient-to-r from-green-50 to-emerald-50 p-4 rounded-xl shadow-md hover:shadow-lg hover:scale-105 transition-all duration-300 border border-green-100/50"
              style={`animation-delay: ${index * 150}ms`}
            >
              <div class="w-12 h-12 flex items-center justify-center bg-gradient-to-br from-green-100 to-emerald-200 rounded-full shadow-sm flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class={`${benefit.icon} text-2xl text-green-700`}></i>
              </div>
              <span class="text-base md:text-lg font-medium text-gray-900">{benefit.text}</span>
            </li>
          ))}
        </ul>

        <!-- Enhanced Premium CTA Button with Shimmer + Glow -->
        <div class="pt-6">
          <a
            href={ctaHref}
            class="hero-cta-button inline-flex items-center justify-center px-12 py-5 text-xl font-bold text-white bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 rounded-2xl shadow-xl hover:shadow-blue-500/50 hover:shadow-2xl hover:scale-105 active:scale-100 transition-all duration-300 relative overflow-hidden group"
          >
            <span class="relative z-10 flex items-center gap-2">
              {ctaText}
              <i class="ri-arrow-right-line text-2xl group-hover:translate-x-1 transition-transform duration-300"></i>
            </span>
            <!-- Enhanced Shimmer overlay -->
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent shimmer-animation"></span>
          </a>
        </div>
      </div>

      <!-- Right Column: Floating Image with 3D Effect -->
      <div class="hidden lg:flex justify-center items-center">
        <div class="floating-image">
          <img
            src={imageUrl}
            alt={imageAlt}
            class="max-w-full h-auto rounded-2xl shadow-2xl hover:shadow-blue-500/30 transition-shadow duration-500"
          />
        </div>
      </div>

    </div>

    <!-- Animated Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex flex-col items-center gap-2">
      <span class="text-sm font-medium text-gray-600">Листайте вниз</span>
      <div class="scroll-indicator w-6 h-10 rounded-full border-2 border-gray-400 flex justify-center p-1">
        <div class="scroll-dot w-1.5 h-1.5 rounded-full bg-gray-600"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Shimmer Animation for Premium CTA Button */
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .shimmer-animation {
    animation: shimmer 3s infinite;
  }

  /* Pause shimmer on hover for better UX */
  .hero-cta-button:hover .shimmer-animation {
    animation-play-state: paused;
  }

  /* Floating Animation for Hero Image */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-10px) rotate(1deg);
    }
    50% {
      transform: translateY(-20px) rotate(-1deg);
    }
    75% {
      transform: translateY(-10px) rotate(1deg);
    }
  }

  .floating-image {
    animation: float 6s ease-in-out infinite;
  }

  /* Benefit Cards Fade-In Animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .benefit-card {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Scroll Indicator Animation */
  @keyframes scrollBounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  .scroll-indicator {
    animation: scrollBounce 2s ease-in-out infinite;
  }

  .scroll-dot {
    animation: scrollBounce 2s ease-in-out infinite;
  }
</style>
