---
/**
 * HowItWorks2Material — Premium Material Design Process Steps
 *
 * Premium Enhancements (2025 trends):
 * - 🎨 Color rotation (Purple → Blue → Green → Orange)
 * - 🌈 Gradient mesh background
 * - 💎 Gradient numbers with colored shadows
 * - 🎬 Stagger animation (fadeInUp) on load
 * - ✨ Premium hover effects (scale + translate-y + shadow)
 * - 🔥 Premium CTA with shimmer + arrow + glow
 * - 💫 H3 gradient headings with hover state
 * - 🚀 Elevated cards with visual depth
 */

interface Step {
  number: number;
  icon: string; // Remix Icon class (e.g., "ri-phone-line")
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  steps: Step[];
  ctaText?: string;
  ctaLink?: string;
}

const { heading, subheading, steps, ctaText, ctaLink = "#" } = Astro.props;

// Color themes for rotation (Purple → Blue → Green → Orange)
const colorThemes = [
  {
    iconBg: 'from-purple-100 to-purple-200',
    iconColor: 'text-purple-600',
    numberGradient: 'from-purple-600 via-purple-500 to-indigo-600',
    shadow: 'shadow-purple-500/20',
    ring: 'ring-purple-200/50',
    glow: 'group-hover:shadow-purple-500/30'
  },
  {
    iconBg: 'from-blue-100 to-blue-200',
    iconColor: 'text-blue-600',
    numberGradient: 'from-blue-600 via-blue-500 to-cyan-600',
    shadow: 'shadow-blue-500/20',
    ring: 'ring-blue-200/50',
    glow: 'group-hover:shadow-blue-500/30'
  },
  {
    iconBg: 'from-green-100 to-green-200',
    iconColor: 'text-green-600',
    numberGradient: 'from-green-600 via-green-500 to-emerald-600',
    shadow: 'shadow-green-500/20',
    ring: 'ring-green-200/50',
    glow: 'group-hover:shadow-green-500/30'
  },
  {
    iconBg: 'from-orange-100 to-orange-200',
    iconColor: 'text-orange-600',
    numberGradient: 'from-orange-600 via-orange-500 to-amber-600',
    shadow: 'shadow-orange-500/20',
    ring: 'ring-orange-200/50',
    glow: 'group-hover:shadow-orange-500/30'
  }
];
---

<section class="relative py-16 md:py-20 lg:py-24 overflow-hidden">
  <!-- Gradient Mesh Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-purple-50/20 to-pink-50/10"></div>
  <div class="absolute inset-0 bg-gradient-to-tl from-cyan-50/30 via-transparent to-indigo-50/20"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(96,165,250,0.05),transparent_50%)]"></div>

  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- Steps Grid with Premium Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {steps.map((step, index) => {
        const theme = colorThemes[index % colorThemes.length];
        return (
          <div
            class={`step-card group bg-white rounded-2xl p-8 shadow-xl ${theme.shadow} ${theme.glow} hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col border border-gray-100 opacity-0`}
            style={`animation-delay: ${index * 100}ms`}
          >
            <!-- Gradient Number Badge -->
            <div class="relative mb-8">
              <div
                class={`w-16 h-16 rounded-2xl bg-gradient-to-br ${theme.iconBg} flex items-center justify-center shadow-lg ${theme.shadow} ring-4 ${theme.ring} mx-auto group-hover:scale-110 group-hover:rotate-6 transition-all duration-300`}
              >
                <span
                  class={`text-3xl font-black bg-gradient-to-br ${theme.numberGradient} bg-clip-text text-transparent`}
                >
                  {step.number}
                </span>
              </div>
            </div>

            <!-- Title with Gradient + Hover -->
            <h3 class="text-xl md:text-2xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent group-hover:from-blue-700 group-hover:via-blue-800 group-hover:to-blue-700 transition-all duration-300 mb-4 text-center">
              {step.title}
            </h3>

            <!-- Description -->
            <p class="text-base text-gray-600 text-center leading-relaxed">
              {step.description}
            </p>
          </div>
        );
      })}
    </div>

    <!-- Premium CTA with Shimmer -->
    {ctaText && (
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href={ctaLink}
          class="cta-button relative inline-flex items-center justify-center px-12 py-5 text-xl font-bold text-white bg-gradient-to-r from-blue-600 via-blue-700 to-blue-600 rounded-2xl shadow-xl hover:shadow-blue-500/50 hover:shadow-2xl hover:scale-105 transition-all duration-300 overflow-hidden group"
        >
          <span class="relative z-10 flex items-center gap-2">
            {ctaText}
            <i class="ri-arrow-right-line text-2xl group-hover:translate-x-1 transition-transform duration-300"></i>
          </span>
          <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent shimmer-animation"></span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* Stagger Animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .step-card {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Shimmer Animation for CTA */
  @keyframes shimmer {
    0% {
      transform: translateX(-100%) skewX(-15deg);
    }
    100% {
      transform: translateX(200%) skewX(-15deg);
    }
  }

  .shimmer-animation {
    animation: shimmer 3s infinite;
  }

  .cta-button:hover .shimmer-animation {
    animation-play-state: paused;
  }
</style>
