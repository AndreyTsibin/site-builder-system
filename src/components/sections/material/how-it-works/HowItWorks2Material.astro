---
/**
 * HowItWorks2Material — Material Design Process Steps with Depth
 *
 * Enhancements over HowItWorks2:
 * - Gradient step cards (light source from top)
 * - Elevated cards with shadows
 * - Enhanced hover states (lift + glow)
 * - Material Design CTA button
 */

interface Step {
  number: number;
  icon: string; // Remix Icon class (e.g., "ri-phone-line")
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  steps: Step[];
  ctaText?: string;
  ctaLink?: string;
}

const { heading, subheading, steps, ctaText, ctaLink = "#" } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- Steps Grid with Material Design Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-4 lg:gap-6">
      {steps.map((step, index) => (
        <div class="flex flex-col md:flex-row lg:flex-col items-center">
          <!-- Step Card with Gradient -->
          <div class="bg-gradient-to-b from-white to-gray-50 rounded-xl p-6 shadow-md hover:shadow-xl hover:scale-105 transition-all duration-300 w-full h-full flex flex-col border border-gray-100">
            <!-- Icon Container -->
            <div class="w-20 h-20 mx-auto mb-6 flex items-center justify-center bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl shadow-sm">
              <i class={`${step.icon} text-5xl text-blue-600`}></i>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              {step.title}
            </h3>

            <!-- Description -->
            <p class="text-base text-gray-600">
              {step.description}
            </p>
          </div>

          <!-- Arrow (hidden on mobile and after last step) -->
          {index < steps.length - 1 && (
            <div class="hidden lg:flex items-center justify-center text-blue-400 text-3xl my-4 lg:my-0 lg:absolute lg:right-[-24px] lg:top-1/2 lg:transform lg:translate-x-1/2 lg:-translate-y-1/2 relative">
              <i class="ri-arrow-right-line hidden lg:block"></i>
              <i class="ri-arrow-down-line block lg:hidden"></i>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- CTA Section with Material Design Button -->
    {ctaText && (
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href={ctaLink}
          class="inline-block px-8 py-4 bg-gradient-to-b from-blue-600 to-blue-800 text-white font-semibold text-lg rounded-lg shadow-md hover:shadow-lg hover:from-blue-700 hover:to-blue-900 active:from-blue-800 active:to-blue-950 active:shadow-sm transition-all duration-300"
        >
          {ctaText}
        </a>
      </div>
    )}
  </div>
</section>
