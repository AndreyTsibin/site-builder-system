---
/**
 * CTA3 — Split CTA with Contact Form
 *
 * Conversion-focused layout with embedded form for lead capture (ideal for mid-page placement).
 * Two-column layout (content left, form right), single-column on mobile.
 */

interface Props {
  heading: string;
  benefits: string[];
  guaranteeText?: string;
  formTitle: string;
  formButtonText: string;
}

const {
  heading,
  benefits,
  guaranteeText,
  formTitle,
  formButtonText,
} = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left: Content -->
      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900">
          {heading}
        </h2>

        <!-- Benefits List -->
        <ul class="space-y-4 mb-6">
          {benefits.map(benefit => (
            <li class="flex items-start gap-3">
              <i class="ri-checkbox-circle-fill text-green-600 text-xl flex-shrink-0 mt-1"></i>
              <span class="text-base md:text-lg text-gray-700">{benefit}</span>
            </li>
          ))}
        </ul>

        <!-- Guarantee Text (optional) -->
        {guaranteeText && (
          <div class="flex items-center gap-3 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <i class="ri-shield-check-line text-blue-600 text-2xl flex-shrink-0"></i>
            <p class="text-sm md:text-base text-blue-900 font-medium">
              {guaranteeText}
            </p>
          </div>
        )}
      </div>

      <!-- Right: Contact Form -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-xl">
        <h3 class="text-xl md:text-2xl font-bold mb-6 text-gray-900 text-center">
          {formTitle}
        </h3>

        <form class="space-y-4">
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Ваше имя
            </label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Иван"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors"
            />
          </div>

          <!-- Phone Field -->
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Телефон
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+7 (___) ___-__-__"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors"
            />
          </div>

          <!-- Message Field (optional) -->
          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Сообщение (необязательно)
            </label>
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="Опишите вашу проблему..."
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-green-600 hover:bg-green-700 text-white text-lg font-bold py-4 rounded-lg transition-colors shadow-lg"
          >
            {formButtonText}
          </button>

          <!-- Privacy Policy -->
          <p class="text-xs text-gray-500 text-center">
            Нажимая кнопку, вы соглашаетесь с{' '}
            <a href="/privacy" class="text-blue-600 hover:underline">
              политикой конфиденциальности
            </a>
          </p>
        </form>
      </div>

    </div>
  </div>
</section>
