---
/**
 * CTA1 — Bold CTA Banner with Stats
 *
 * High-impact banner with urgency message and social proof for maximum conversions.
 * Two-column layout on desktop (content left, CTA block right), single-column on mobile.
 */

interface Props {
  heading: string;
  subheading: string;
  phone: string;
  ctaText: string;
  stats: Array<{
    value: string;
    label: string;
  }>;
}

const { heading, subheading, phone, ctaText, stats } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gradient-to-r from-blue-600 to-blue-800">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Left: Content -->
      <div class="text-white">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
          {heading}
        </h2>
        <p class="text-lg md:text-xl mb-8 text-white/90">
          {subheading}
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-4">
          {stats.map(stat => (
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
              <div class="text-2xl md:text-3xl font-bold mb-1">
                {stat.value}
              </div>
              <div class="text-sm md:text-base text-white/80">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: CTA Block -->
      <div class="bg-white rounded-2xl p-6 md:p-8 border-2 border-gray-200">
        <div class="text-center">
          <!-- Phone Number -->
          <a
            href={`tel:${phone.replace(/\s/g, '')}`}
            class="inline-flex items-center gap-2 text-2xl md:text-3xl font-bold text-gray-900 hover:text-blue-700 transition-colors mb-6"
          >
            <i class="ri-phone-line text-blue-700"></i>
            {phone}
          </a>

          <!-- CTA Button -->
          <a
            href={`tel:${phone.replace(/\s/g, '')}`}
            class="block w-full bg-blue-700 hover:bg-blue-800 text-white text-lg md:text-xl font-bold py-4 px-8 rounded-xl transition-colors"
          >
            {ctaText}
          </a>

          <!-- Additional Info -->
          <p class="text-sm text-gray-600 mt-4">
            Звоните прямо сейчас — первая консультация бесплатна
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
