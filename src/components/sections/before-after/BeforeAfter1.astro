---
/**
 * BeforeAfter1: Single Comparison with Description
 *
 * Interactive before/after slider with draggable divider.
 * Features: CSS-only slider, touch/mouse support, responsive design.
 * Best for: Showcasing single repair result, case study, testimonial hero.
 */

interface Props {
  title: string; // "Результаты наших работ"
  subtitle?: string; // "Мы гарантируем качество каждого ремонта"
  imageBefore: string; // Path to before image
  imageAfter: string; // Path to after image
  serviceLabel: string; // "Ремонт холодильника Bosch"
  description: string; // "Восстановление компрессора, 1 день"
  ctaText: string; // "Заказать ремонт"
  ctaLink?: string; // "#contact" or tel:
  bgColor?: string; // "white" | "gray-50"
}

const {
  title,
  subtitle,
  imageBefore,
  imageAfter,
  serviceLabel,
  description,
  ctaText,
  ctaLink = "#contact",
  bgColor = "white"
} = Astro.props;
---

<section class={`py-16 md:py-20 lg:py-24 bg-${bgColor}`}>
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    {/* Before/After Slider Container */}
    <div class="max-w-5xl mx-auto mb-8">
      <div class="before-after-slider relative overflow-hidden rounded-2xl shadow-2xl" style="aspect-ratio: 16/9;">
        {/* Before Image (bottom layer) */}
        <img
          src={imageBefore}
          alt="До ремонта"
          class="absolute inset-0 w-full h-full object-cover"
        />

        {/* After Image (top layer, clipped) */}
        <div
          class="before-after-overlay absolute inset-0"
          style="clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);"
        >
          <img
            src={imageAfter}
            alt="После ремонта"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>

        {/* Labels */}
        <div class="absolute top-4 left-4 bg-black/70 text-white px-4 py-2 rounded-lg text-sm font-semibold">
          До
        </div>
        <div class="absolute top-4 right-4 bg-black/70 text-white px-4 py-2 rounded-lg text-sm font-semibold">
          После
        </div>

        {/* Slider Handle */}
        <div class="before-after-handle absolute top-0 bottom-0 w-1 bg-white cursor-ew-resize" style="left: 50%; transform: translateX(-50%);">
          {/* Circular drag handle */}
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 bg-white rounded-full shadow-xl flex items-center justify-center">
            <i class="ri-arrow-left-right-line text-xl text-gray-900"></i>
          </div>
        </div>

        {/* Range Input (invisible, controls slider) */}
        <input
          type="range"
          min="0"
          max="100"
          value="50"
          class="before-after-input absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-10"
          aria-label="Сравнить до и после"
        />
      </div>
    </div>

    {/* Service Info */}
    <div class="text-center mb-8">
      <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
        {serviceLabel}
      </h3>
      <p class="text-base md:text-lg text-gray-600">
        {description}
      </p>
    </div>

    {/* CTA */}
    <div class="text-center">
      <a
        href={ctaLink}
        class="inline-block px-8 py-4 bg-blue-700 text-white font-bold text-lg rounded-xl hover:bg-blue-800 transition-colors"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>

<script>
  // Before/After slider interaction
  const initSlider = () => {
    const sliders = document.querySelectorAll('.before-after-slider');

    sliders.forEach((slider) => {
      const input = slider.querySelector('.before-after-input') as HTMLInputElement;
      const overlay = slider.querySelector('.before-after-overlay') as HTMLElement;
      const handle = slider.querySelector('.before-after-handle') as HTMLElement;

      if (!input || !overlay || !handle) return;

      const updateSlider = (value: number) => {
        // Update overlay clip-path
        overlay.style.clipPath = `polygon(0 0, ${value}% 0, ${value}% 100%, 0 100%)`;
        // Update handle position
        handle.style.left = `${value}%`;
      };

      // Handle input change
      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        updateSlider(parseInt(target.value));
      });

      // Initial position
      updateSlider(50);
    });
  };

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initSlider);

  // Re-initialize after navigation (for SPAs)
  document.addEventListener('astro:page-load', initSlider);
</script>
