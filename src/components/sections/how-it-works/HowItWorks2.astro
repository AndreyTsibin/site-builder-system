---
interface Step {
  number: number;
  icon: string; // Remix Icon class (e.g., "ri-phone-line")
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  steps: Step[];
  ctaText?: string;
  ctaLink?: string;
}

const { heading, subheading, steps, ctaText, ctaLink = "#" } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-white">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- Steps Grid with Arrows -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-4 lg:gap-6">
      {steps.map((step, index) => (
        <div class="flex flex-col md:flex-row lg:flex-col items-center">
          <!-- Step Card -->
          <div class="bg-white border-2 border-gray-200 rounded-xl p-6 hover:border-blue-400 hover:shadow-lg transition-all hover:scale-105 w-full h-full flex flex-col">
            <!-- Icon -->
            <i class={`${step.icon} text-6xl text-blue-600 mb-6 block`}></i>

            <!-- Title -->
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              {step.title}
            </h3>

            <!-- Description -->
            <p class="text-base text-gray-600">
              {step.description}
            </p>
          </div>

          <!-- Arrow (hidden on mobile and after last step) -->
          {index < steps.length - 1 && (
            <div class="hidden lg:flex items-center justify-center text-blue-400 text-3xl my-4 lg:my-0 lg:absolute lg:right-[-24px] lg:top-1/2 lg:transform lg:translate-x-1/2 lg:-translate-y-1/2 relative">
              <i class="ri-arrow-right-line hidden lg:block"></i>
              <i class="ri-arrow-down-line block lg:hidden"></i>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- CTA Section (Optional) -->
    {ctaText && (
      <div class="mt-12 lg:mt-16 text-center">
        <a
          href={ctaLink}
          class="inline-block px-8 py-4 bg-blue-600 text-white font-semibold text-lg rounded-lg hover:bg-blue-700 transition-colors shadow-md hover:shadow-lg"
        >
          {ctaText}
        </a>
      </div>
    )}
  </div>
</section>
