---
interface Step {
  number: number;
  icon: string; // Remix Icon class (e.g., "ri-phone-line")
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  steps: Step[];
  ctaText?: string;
  ctaLink?: string;
}

const { heading, subheading, steps, ctaText, ctaLink = "#" } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gray-50">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- Timeline -->
    <div class="max-w-4xl mx-auto">
      <div class="relative">
        <!-- Vertical Line (hidden on mobile, visible on md+) -->
        <div class="hidden md:block absolute left-8 top-0 bottom-0 w-0.5 bg-blue-200"></div>

        <!-- Steps -->
        <div class="space-y-8 md:space-y-12">
          {steps.map((step, index) => (
            <div class="relative flex gap-6 md:gap-8">
              <!-- Number Badge -->
              <div class="flex-shrink-0">
                <div class={`
                  w-16 h-16 rounded-full flex items-center justify-center text-2xl font-bold z-10 relative
                  ${index === steps.length - 1 ? 'bg-green-600 text-white' : 'bg-blue-600 text-white'}
                `}>
                  {step.number}
                </div>
              </div>

              <!-- Content -->
              <div class="flex-grow pt-2 pb-4">
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
                  <!-- Icon & Title -->
                  <div class="flex items-start gap-4 mb-3">
                    <i class={`${step.icon} text-3xl ${index === steps.length - 1 ? 'text-green-600' : 'text-blue-600'}`}></i>
                    <h3 class="text-xl md:text-2xl font-bold text-gray-900 flex-grow">
                      {step.title}
                    </h3>
                  </div>

                  <!-- Description -->
                  <p class="text-base md:text-lg text-gray-600">
                    {step.description}
                  </p>

                  <!-- CTA for last step -->
                  {index === steps.length - 1 && ctaText && (
                    <a
                      href={ctaLink}
                      class="inline-block mt-4 px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-colors"
                    >
                      {ctaText}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
