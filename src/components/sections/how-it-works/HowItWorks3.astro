---
interface Step {
  number: number;
  icon: string; // Remix Icon class (e.g., "ri-phone-line")
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  steps: Step[];
}

const { heading, subheading, steps } = Astro.props;
---

<section class="py-16 md:py-20 lg:py-24 bg-gradient-to-b from-blue-50 to-white">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        {heading}
      </h2>
      {subheading && (
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
          {subheading}
        </p>
      )}
    </div>

    <!-- Number Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
      {steps.map((step) => (
        <div class="text-center group">
          <!-- Number Circle -->
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-blue-600 text-white text-3xl font-bold mb-6 group-hover:scale-110 transition-transform">
            {step.number}
          </div>

          <!-- Title -->
          <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3">
            {step.title}
          </h3>

          <!-- Description -->
          <p class="text-base md:text-lg text-gray-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
