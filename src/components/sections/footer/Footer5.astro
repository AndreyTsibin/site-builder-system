---
interface Props {
  logo: string;
  logoIcon?: string;
  phone: string;
  workingHours?: string;
  email?: string;
  socialLinks?: {
    vk?: string;
    telegram?: string;
    whatsapp?: string;
  };
  menuItems?: { label: string; href: string }[];
  copyrightText?: string;
  companyDetails?: {
    legalForm?: string;
    inn?: string;
    ogrn?: string;
  };
}

const {
  logo = 'Ремонт Техники',
  logoIcon = 'ri-tools-line',
  phone = '+7 (495) 123-45-67',
  workingHours = 'Ежедневно с 9:00 до 21:00',
  email = 'info@remont-service.ru',
  socialLinks = {
    vk: 'https://vk.com/',
    telegram: 'https://t.me/',
    whatsapp: 'https://wa.me/'
  },
  menuItems = [
    { label: 'Главная', href: '#home' },
    { label: 'Услуги', href: '#services' },
    { label: 'Цены', href: '#pricing' },
    { label: 'Отзывы', href: '#testimonials' },
    { label: 'Контакты', href: '#contacts' }
  ],
  copyrightText = 'Все права защищены',
  companyDetails = {
    legalForm: 'ИП Иванов Иван Иванович',
    inn: '773456789012',
    ogrn: '123456789012345'
  }
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20">

    <!-- Centered Column Layout -->
    <div class="max-w-2xl mx-auto text-center space-y-8">

      <!-- Logo -->
      <div class="flex items-center justify-center gap-2">
        <i class={`${logoIcon} text-3xl text-green-500`}></i>
        <span class="text-2xl md:text-3xl font-bold text-white">{logo}</span>
      </div>

      <!-- Phone + Working Hours -->
      <div class="space-y-2">
        <a
          href={`tel:${phone.replace(/[^\d+]/g, '')}`}
          class="inline-flex items-center gap-3 text-xl md:text-2xl font-bold text-white hover:text-green-400 transition-colors"
        >
          <i class="ri-phone-line text-2xl text-green-500"></i>
          <span>{phone}</span>
        </a>
        {workingHours && (
          <p class="text-sm md:text-base text-gray-400">{workingHours}</p>
        )}
      </div>

      <!-- Email (Optional) -->
      {email && (
        <a
          href={`mailto:${email}`}
          class="inline-flex items-center gap-2 text-sm md:text-base hover:text-green-400 transition-colors"
        >
          <i class="ri-mail-line text-lg text-green-500"></i>
          <span>{email}</span>
        </a>
      )}

      <!-- Social Links -->
      {socialLinks && (
        <div class="flex justify-center gap-4">
          {socialLinks.vk && (
            <a
              href={socialLinks.vk}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 flex items-center justify-center rounded-full bg-gray-800 hover:bg-blue-600 transition-colors"
              aria-label="VK"
            >
              <i class="ri-vk-line text-xl"></i>
            </a>
          )}
          {socialLinks.telegram && (
            <a
              href={socialLinks.telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 flex items-center justify-center rounded-full bg-gray-800 hover:bg-blue-500 transition-colors"
              aria-label="Telegram"
            >
              <i class="ri-telegram-line text-xl"></i>
            </a>
          )}
          {socialLinks.whatsapp && (
            <a
              href={socialLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 flex items-center justify-center rounded-full bg-gray-800 hover:bg-green-500 transition-colors"
              aria-label="WhatsApp"
            >
              <i class="ri-whatsapp-line text-xl"></i>
            </a>
          )}
        </div>
      )}

      <!-- Navigation -->
      {menuItems && (
        <nav class="flex flex-wrap justify-center gap-4 md:gap-6 text-sm md:text-base">
          {menuItems.map((item) => (
            <a
              href={item.href}
              class="hover:text-blue-400 transition-colors"
            >
              {item.label}
            </a>
          ))}
        </nav>
      )}

      <!-- Divider -->
      <div class="border-t border-gray-800 pt-8 space-y-3">
        <p class="text-sm text-gray-500">
          © {currentYear} {logo}. {copyrightText}
        </p>
        {companyDetails && (
          <!--noindex-->
          <div class="text-xs text-gray-600 flex flex-col md:flex-row md:gap-3 justify-center">
            {companyDetails.legalForm && <p>{companyDetails.legalForm}</p>}
            {companyDetails.inn && <p>ИНН: {companyDetails.inn}</p>}
            {companyDetails.ogrn && <p>ОГРН: {companyDetails.ogrn}</p>}
          </div>
          <!--/noindex-->
        )}
        <div class="flex flex-wrap justify-center gap-4 text-xs text-gray-600">
          <a href="#privacy" class="hover:text-gray-400 transition-colors">Политика конфиденциальности</a>
          <span>•</span>
          <a href="#terms" class="hover:text-gray-400 transition-colors">Условия использования</a>
        </div>
      </div>
    </div>
  </div>
</footer>
