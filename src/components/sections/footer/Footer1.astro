---
interface Props {
  logo: string;
  logoIcon?: string;
  description?: string;
  phone: string;
  workingHours?: string;
  email: string;
  address: string;
  socialLinks?: {
    vk?: string;
    telegram?: string;
    whatsapp?: string;
  };
  menuItems?: { label: string; href: string }[];
  showMap?: boolean;
  mapUrl?: string;
  copyrightText?: string;
  companyDetails?: {
    legalForm?: string;
    inn?: string;
    ogrn?: string;
  };
}

const {
  logo = 'Ремонт Техники',
  logoIcon = 'ri-tools-line',
  description = 'Профессиональный ремонт бытовой техники с гарантией качества',
  phone = '+7 (495) 123-45-67',
  workingHours = 'Ежедневно с 9:00 до 21:00',
  email = 'info@remont-service.ru',
  address = 'г. Москва, ул. Примерная, д. 10',
  socialLinks = {
    vk: 'https://vk.com/',
    telegram: 'https://t.me/',
    whatsapp: 'https://wa.me/'
  },
  menuItems = [
    { label: 'Главная', href: '#home' },
    { label: 'Услуги', href: '#services' },
    { label: 'Цены', href: '#pricing' },
    { label: 'Контакты', href: '#contacts' }
  ],
  showMap = true,
  mapUrl = 'https://yandex.ru/map-widget/v1/?um=constructor%3Aec8f0fbfd6a26fcd7b5a50e51e0b7d3a1c90c8e8e72c8e8e8e8e8e8e8e8e&amp;source=constructor',
  copyrightText = 'Все права защищены',
  companyDetails = {
    legalForm: 'ИП Иванов Иван Иванович',
    inn: '773456789012',
    ogrn: '123456789012345'
  }
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <!-- Main Footer Content -->
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20">
    <!-- Top Section: Logo, Contacts, Navigation -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12 mb-12">

      <!-- Column 1: Logo + Description -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <i class={`${logoIcon} text-2xl text-green-500`}></i>
          <span class="text-xl md:text-2xl font-bold text-white">{logo}</span>
        </div>
        {description && (
          <p class="text-sm md:text-base text-gray-400 leading-relaxed">
            {description}
          </p>
        )}
      </div>

      <!-- Column 2: Contacts -->
      <div class="space-y-4">
        <h3 class="text-base md:text-lg font-semibold text-white mb-4">Контакты</h3>

        <div class="space-y-3">
          <!-- Phone -->
          <a href={`tel:${phone.replace(/[^\d+]/g, '')}`} class="flex items-start gap-3 hover:text-green-400 transition-colors group">
            <i class="ri-phone-line text-xl text-green-500 flex-shrink-0 mt-0.5"></i>
            <div>
              <div class="font-semibold text-white group-hover:text-green-400 transition-colors">{phone}</div>
              {workingHours && <div class="text-sm text-gray-500">{workingHours}</div>}
            </div>
          </a>

          <!-- Email -->
          <a href={`mailto:${email}`} class="flex items-center gap-3 hover:text-green-400 transition-colors">
            <i class="ri-mail-line text-xl text-green-500 flex-shrink-0"></i>
            <span>{email}</span>
          </a>

          <!-- Address -->
          <div class="flex items-start gap-3">
            <i class="ri-map-pin-line text-xl text-green-500 flex-shrink-0 mt-0.5"></i>
            <span>{address}</span>
          </div>
        </div>
      </div>

      <!-- Column 3: Navigation + Social Links -->
      <div class="space-y-6">
        <!-- Navigation -->
        <div>
          <h3 class="text-base md:text-lg font-semibold text-white mb-4">Навигация</h3>
          <nav class="space-y-2">
            {menuItems && menuItems.map((item) => (
              <a
                href={item.href}
                class="block text-sm md:text-base hover:text-blue-400 transition-colors"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- Social Links -->
        {socialLinks && (
          <div>
            <h3 class="text-base md:text-lg font-semibold text-white mb-4">Мы в соцсетях</h3>
            <div class="flex gap-4">
              {socialLinks.vk && (
                <a
                  href={socialLinks.vk}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-blue-600 transition-colors"
                  aria-label="VK"
                >
                  <i class="ri-vk-line text-xl"></i>
                </a>
              )}
              {socialLinks.telegram && (
                <a
                  href={socialLinks.telegram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-blue-500 transition-colors"
                  aria-label="Telegram"
                >
                  <i class="ri-telegram-line text-xl"></i>
                </a>
              )}
              {socialLinks.whatsapp && (
                <a
                  href={socialLinks.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-green-500 transition-colors"
                  aria-label="WhatsApp"
                >
                  <i class="ri-whatsapp-line text-xl"></i>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Yandex Map Section -->
    {showMap && mapUrl && (
      <div class="mb-12">
        <div class="w-full h-[300px] md:h-[400px] rounded-xl overflow-hidden">
          <iframe
            src={mapUrl}
            width="100%"
            height="100%"
            frameborder="0"
            loading="lazy"
            title="Наше местоположение на карте"
          ></iframe>
        </div>
      </div>
    )}
  </div>

  <!-- Bottom Section: Copyright -->
  <div class="border-t border-gray-800">
    <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <div class="flex flex-col items-center md:items-start gap-2">
          <p>© {currentYear} {logo}. {copyrightText}</p>
          {companyDetails && (
            <!--noindex-->
            <div class="text-xs text-gray-600 flex flex-col md:flex-row md:gap-3">
              {companyDetails.legalForm && <p>{companyDetails.legalForm}</p>}
              {companyDetails.inn && <p>ИНН: {companyDetails.inn}</p>}
              {companyDetails.ogrn && <p>ОГРН: {companyDetails.ogrn}</p>}
            </div>
            <!--/noindex-->
          )}
        </div>
        <div class="flex gap-6">
          <a href="#privacy" class="hover:text-gray-300 transition-colors">Политика конфиденциальности</a>
          <a href="#terms" class="hover:text-gray-300 transition-colors">Условия использования</a>
        </div>
      </div>
    </div>
  </div>
</footer>
