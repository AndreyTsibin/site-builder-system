---
interface Props {
  logo: string;
  logoIcon?: string;
  phone: string;
  workingHours?: string;
  email: string;
  address: string;
  socialLinks?: {
    vk?: string;
    telegram?: string;
    whatsapp?: string;
  };
  menuItems?: { label: string; href: string }[];
  formTitle?: string;
  formSubtitle?: string;
  formButtonText?: string;
  privacyText?: string;
  copyrightText?: string;
  companyDetails?: {
    legalForm?: string;
    inn?: string;
    ogrn?: string;
  };
}

const {
  logo = 'Ремонт Техники',
  logoIcon = 'ri-tools-line',
  phone = '+7 (495) 123-45-67',
  workingHours = 'Ежедневно 9:00 - 21:00',
  email = 'info@remont-service.ru',
  address = 'г. Москва, ул. Примерная, д. 10',
  socialLinks = {
    vk: 'https://vk.com/',
    telegram: 'https://t.me/',
    whatsapp: 'https://wa.me/'
  },
  menuItems = [
    { label: 'Главная', href: '#home' },
    { label: 'Услуги', href: '#services' },
    { label: 'Цены', href: '#pricing' },
    { label: 'Отзывы', href: '#testimonials' },
    { label: 'Контакты', href: '#contacts' }
  ],
  formTitle = 'Получить консультацию',
  formSubtitle = 'Оставьте заявку и мы перезвоним в течение 5 минут',
  formButtonText = 'Отправить заявку',
  privacyText = 'Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности',
  copyrightText = 'Все права защищены',
  companyDetails = {
    legalForm: 'ИП Иванов Иван Иванович',
    inn: '773456789012',
    ogrn: '123456789012345'
  }
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <!-- Main Footer Content -->
  <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20">
    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">

      <!-- Left Section: Logo, Contacts, Navigation, Social (60% = 3 columns) -->
      <div class="lg:col-span-3 space-y-8">

        <!-- Logo -->
        <div class="flex items-center gap-2">
          <i class={`${logoIcon} text-2xl text-green-500`}></i>
          <span class="text-xl md:text-2xl font-bold text-white">{logo}</span>
        </div>

        <!-- Contacts + Navigation Grid -->
        <div class="grid sm:grid-cols-2 gap-8">

          <!-- Contacts -->
          <div class="space-y-4">
            <h3 class="text-base md:text-lg font-semibold text-white">Контакты</h3>

            <div class="space-y-3">
              <!-- Phone -->
              <a href={`tel:${phone.replace(/[^\d+]/g, '')}`} class="flex items-start gap-3 hover:text-green-400 transition-colors group">
                <i class="ri-phone-line text-lg text-green-500 flex-shrink-0 mt-0.5"></i>
                <div>
                  <div class="text-sm font-semibold text-white group-hover:text-green-400 transition-colors">{phone}</div>
                  {workingHours && <div class="text-xs text-gray-500">{workingHours}</div>}
                </div>
              </a>

              <!-- Email -->
              <a href={`mailto:${email}`} class="flex items-center gap-3 text-sm hover:text-green-400 transition-colors">
                <i class="ri-mail-line text-lg text-green-500 flex-shrink-0"></i>
                <span class="break-all">{email}</span>
              </a>

              <!-- Address -->
              <div class="flex items-start gap-3 text-sm">
                <i class="ri-map-pin-line text-lg text-green-500 flex-shrink-0 mt-0.5"></i>
                <span>{address}</span>
              </div>
            </div>
          </div>

          <!-- Navigation -->
          <div class="space-y-4">
            <h3 class="text-base md:text-lg font-semibold text-white">Навигация</h3>
            <nav class="space-y-2">
              {menuItems && menuItems.map((item) => (
                <a
                  href={item.href}
                  class="block text-sm hover:text-blue-400 transition-colors"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </div>

        <!-- Social Links -->
        {socialLinks && (
          <div>
            <h3 class="text-base md:text-lg font-semibold text-white mb-4">Мы в соцсетях</h3>
            <div class="flex gap-3">
              {socialLinks.vk && (
                <a
                  href={socialLinks.vk}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-blue-600 transition-colors"
                  aria-label="VK"
                >
                  <i class="ri-vk-line text-xl"></i>
                </a>
              )}
              {socialLinks.telegram && (
                <a
                  href={socialLinks.telegram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-blue-500 transition-colors"
                  aria-label="Telegram"
                >
                  <i class="ri-telegram-line text-xl"></i>
                </a>
              )}
              {socialLinks.whatsapp && (
                <a
                  href={socialLinks.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-green-500 transition-colors"
                  aria-label="WhatsApp"
                >
                  <i class="ri-whatsapp-line text-xl"></i>
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <!-- Right Section: Contact Form (40% = 2 columns) -->
      <div class="lg:col-span-2">
        <div class="bg-gray-800 rounded-lg p-6 md:p-8">
          <h3 class="text-xl md:text-2xl font-bold text-white mb-2">{formTitle}</h3>
          {formSubtitle && (
            <p class="text-sm text-gray-400 mb-6">{formSubtitle}</p>
          )}

          <form class="space-y-4">
            <!-- Name Input -->
            <div>
              <label for="footer-name" class="block text-sm font-medium text-gray-300 mb-2">
                Ваше имя
              </label>
              <input
                type="text"
                id="footer-name"
                name="name"
                placeholder="Иван"
                required
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
              />
            </div>

            <!-- Phone Input -->
            <div>
              <label for="footer-phone" class="block text-sm font-medium text-gray-300 mb-2">
                Телефон
              </label>
              <input
                type="tel"
                id="footer-phone"
                name="phone"
                placeholder="+7 (___) ___-__-__"
                required
                class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
              />
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition-colors"
            >
              {formButtonText}
            </button>

            <!-- Privacy Text -->
            {privacyText && (
              <p class="text-xs text-gray-500 leading-relaxed">
                {privacyText}
              </p>
            )}
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Section: Copyright -->
  <div class="border-t border-gray-800">
    <div class="max-w-[1344px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <div class="flex flex-col items-center md:items-start gap-2">
          <p>© {currentYear} {logo}. {copyrightText}</p>
          {companyDetails && (
            <!--noindex-->
            <div class="text-xs text-gray-600 flex flex-col md:flex-row md:gap-3">
              {companyDetails.legalForm && <p>{companyDetails.legalForm}</p>}
              {companyDetails.inn && <p>ИНН: {companyDetails.inn}</p>}
              {companyDetails.ogrn && <p>ОГРН: {companyDetails.ogrn}</p>}
            </div>
            <!--/noindex-->
          )}
        </div>
        <div class="flex flex-wrap justify-center gap-4 md:gap-6">
          <a href="#privacy" class="hover:text-gray-300 transition-colors">Политика конфиденциальности</a>
          <a href="#terms" class="hover:text-gray-300 transition-colors">Условия использования</a>
        </div>
      </div>
    </div>
  </div>
</footer>
